{{- if has "opencode" (index . "tools") -}}
#!{{ lookPath "sh" }}
# 選裝工具 OpenCode(選單見 .chezmoi.toml.tmpl)。沒勾就渲染成空的,chezmoi 不跑。
set -eu

# 1. 已經有就不重裝
if command -v opencode >/dev/null 2>&1 || [ -x "$HOME/.opencode/bin/opencode" ]; then
  echo "OpenCode 已安裝,跳過"
  exit 0
fi

# 2. 安裝。--no-modify-path:不准改 shell 設定檔,PATH 由 chezmoi 管的 .zshrc 負責
#    先下載再跑:接 pipe 的話 curl 失敗會被吞掉(shell 讀到空的就 exit 0),apply 看起來成功卻什麼都沒裝
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fsSL -o "$tmp/install.sh" https://opencode.ai/install
bash "$tmp/install.sh" --no-modify-path
{{ end -}}
