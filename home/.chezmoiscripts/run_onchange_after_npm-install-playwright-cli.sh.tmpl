{{- /* 跟 .chezmoi.toml.tmpl 的選單過濾同一套條件(同 headless-chrome):WSL、非 amd64、非 Debian 系就算 tools 裡有也不裝 */ -}}
{{- $wsl := eq (includeTemplate "is-wsl" .) "true" -}}
{{- if and (has "playwright-cli" (index . "tools")) (not $wsl) (eq .chezmoi.arch "amd64") (includeTemplate "is-debian" .) -}}
#!{{ lookPath "sh" }}
# 選裝工具 playwright-cli(選單見 .chezmoi.toml.tmpl)。沒勾就渲染成空的,chezmoi 不跑。
# agent 操作瀏覽器用它(ADR 0001)。瀏覽器用的是 headless-chrome 裝的 /opt/google/chrome/chrome,
# 沒有那支就報錯,不會自己下載。
#
# 檔名刻意不叫 install-playwright-cli:理由同 npm-install-codegraph,要排在 install-nvm 之後。
set -eu

# 1. 載入 nvm(chezmoi 跑腳本時不會讀 .zshrc)
if ! command -v npm >/dev/null 2>&1 && [ -s "$HOME/.nvm/nvm.sh" ]; then
  export NVM_DIR="$HOME/.nvm"
  set +u; . "$NVM_DIR/nvm.sh"; set -u
fi

# 2. 已經有就不重裝
if command -v playwright-cli >/dev/null 2>&1; then
  echo "playwright-cli 已安裝,跳過"
  exit 0
fi

# 3. 安裝
command -v npm >/dev/null 2>&1 || { echo "playwright-cli 要 npm:tools 一起勾 nvm(chezmoi edit-config 改 tools 再 apply)" >&2; exit 1; }
npm install -g @playwright/cli

# 4. 沒有 Chrome 只提醒,不算失敗:CLI 本身裝好了,之後補勾 headless-chrome 就能用
[ -x /opt/google/chrome/chrome ] || echo "playwright-cli 找不到 /opt/google/chrome/chrome:要開瀏覽器請一起勾 headless-chrome" >&2
{{ end -}}
