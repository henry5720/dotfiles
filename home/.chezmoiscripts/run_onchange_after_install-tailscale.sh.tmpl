{{- if has "tailscale" (index . "tools") -}}
#!{{ lookPath "sh" }}
# 選裝工具 tailscale(選單見 .chezmoi.toml.tmpl)。沒勾就渲染成空的,chezmoi 不跑。
# 不會執行 tailscale up,登入與設定自己來。
set -eu

# 1. 系統層的 tailscaled 已經在跑(例如管理員裝好的機器)就整段跳過:不裝、不 enable、不走 userspace,
#    所以不需要 root。
{{ template "sh-tailscale-running" . }}
if tailscale_running; then
  echo "系統層的 tailscaled 已經在跑,跳過"
  exit 0
fi
{{- if includeTemplate "has-root" . }}
{{ template "sh-sudo" . }}
# 2. 裝(官方 installer 會加 apt 來源)。~/.local/bin 那份是沒有 root 時裝的 userspace 版,不算:
#    它沒有系統的 tailscaled unit,下面 systemctl enable 會失敗
if p=$(command -v tailscale) && [ "$p" != "$HOME/.local/bin/tailscale" ]; then
  echo "tailscale 已安裝,跳過安裝"
else
  # 先下載再跑:接 pipe 的話 curl 失敗會被吞掉,sh 讀到空的就 exit 0
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  curl -fsSL -o "$tmp/install.sh" https://tailscale.com/install.sh
  sh "$tmp/install.sh"
fi

# 3. 開機自動啟動 tailscaled。PID 1 不是 systemd(沒開 systemd 的 WSL、容器)就跳過,不算失敗
if [ -d /run/systemd/system ]; then
  $SUDO systemctl enable --now tailscaled
else
  echo "PID 1 不是 systemd,已安裝但未啟動 tailscaled;WSL 請在 /etc/wsl.conf 開 systemd 後再 apply 一次或手動啟動"
fi
echo "不會執行 tailscale up;請自行登入與設定。"
{{- else }}
{{ template "sh-skip" . }}
# 2. 沒有 root(.chezmoitemplates/has-root):官方 installer 要加 apt 來源、tailscaled 要開 TUN,都做不了。
#    改走 userspace 模式(tailscaled 變成只給這個使用者用的 proxy,不用 root):官方 static tarball 的
#    tailscale、tailscaled 放 ~/.local/bin,狀態放 ~/.local/state/tailscale。勾了 zsh 的話,之後開 zsh 時
#    tailscaled 沒在跑就背景起來(.zshrc);沒勾 zsh 就沒有 .zshrc,提示裡給手動啟動的指令。
#    登入要人打開網址核准,記進略過彙整。
#    跟 jq、ttyd 一樣抓最新版,chezmoi 不負責更新。下載失敗不讓 apply 失敗(沒有 root 時整個 apply 照樣
#    exit 0),記進略過彙整。
bin=$HOME/.local/bin
state=$HOME/.local/state/tailscale
sock='$HOME/.local/state/tailscale/tailscaled.sock' # 給人複製的字串,$HOME 留著不展開
{{- if has "zsh" (index . "tools") }}
start="開一個新的 zsh(tailscaled 沒在跑會自己背景起來)"
keep="之後每次開 zsh 都會檢查"
{{- else }}
start="啟動 tailscaled --tun=userspace-networking --statedir=\$HOME/.local/state/tailscale --socket=$sock --port=0 &"
keep="沒勾 zsh,不會自己起來,每次要用先照上面啟動"
{{- end }}
login_hint="登入:$start,再跑 tailscale --socket=$sock up,打開印出的網址核准
    常駐:$keep;要開機就起,用 systemd user service(要 loginctl enable-linger,通常要管理員)或 crontab 的 @reboot
    ssh 連 tailnet 的機器:~/.ssh/config 的 company-ec2 已經帶 ProxyCommand(tailscale --socket=$sock nc %h %p)"

# 2.1 已經裝過就不重新下載(腳本內容改了、run_onchange 重跑時)。還沒登入才再提醒一次
#     (tailscaled 沒在跑時 status 也失敗,會多提醒一次,不影響結果)
if [ -x "$bin/tailscale" ] && [ -x "$bin/tailscaled" ]; then
  echo "userspace tailscale 已經裝過(~/.local/bin),不重新下載"
  mkdir -p "$state"
  "$bin/tailscale" --socket="$state/tailscaled.sock" status >/dev/null 2>&1 || skip_root tailscale "$login_hint"
  exit 0
fi

# 2.2 架構對到官方 tarball 的名字
case "$(uname -m)" in
  x86_64) arch=amd64 ;;
  aarch64 | arm64) arch=arm64 ;;
  armv6l | armv7l) arch=arm ;;
  i386 | i686) arch=386 ;;
  *)
    skip_root tailscale "官方沒有 $(uname -m) 的 static tarball,沒有裝 userspace tailscale"
    exit 0
    ;;
esac
url="https://pkgs.tailscale.com/stable/tailscale_latest_$arch.tgz"

# 2.3 下載、解到暫存目錄,確認跑得起來才放進 ~/.local/bin;哪一步失敗都不留半套
echo "沒有 root:下載官方 static tarball,把 tailscale、tailscaled 裝到 ~/.local/bin(userspace 模式)"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
if ! { curl -fsSL -o "$tmp/ts.tgz" "$url" && tar -xzf "$tmp/ts.tgz" -C "$tmp" &&
  src=$(echo "$tmp"/tailscale_*_"$arch") && "$src/tailscale" version >/dev/null; }; then
  skip_root tailscale "下載失敗($url),沒有裝 userspace tailscale。網路好了手動:下載那個 tgz,把裡面的 tailscale、tailscaled 放進 ~/.local/bin,再照下面登入
    $login_hint"
  exit 0
fi
mkdir -p "$bin" "$state"
cp "$src/tailscale" "$bin/.tailscale.tmp"
cp "$src/tailscaled" "$bin/.tailscaled.tmp"
mv -f "$bin/.tailscale.tmp" "$bin/tailscale"
mv -f "$bin/.tailscaled.tmp" "$bin/tailscaled"
echo "tailscale $("$bin/tailscale" version | head -n 1) 裝到 ~/.local/bin"
skip_root tailscale "$login_hint"
{{- end }}
{{ end -}}
