{{- if has "codegraph" (splitList " " (includeTemplate "tools-to-install" .)) -}}
#!{{ lookPath "sh" }}
# 選裝工具 codegraph CLI(選單見 .chezmoi.toml.tmpl)。沒勾就渲染成空的,chezmoi 不跑。
#
# 檔名刻意不叫 install-codegraph:chezmoi 依檔名字母順序跑腳本,它要 npm,
# 必須排在 install-node 之後(勾了 codegraph 就會一併裝 nvm),第一次 apply 才裝得起來。
set -eu

# 1. 載入 nvm(chezmoi 跑腳本時不會讀 .zshrc)
if ! command -v npm >/dev/null 2>&1 && [ -s "$HOME/.nvm/nvm.sh" ]; then
  export NVM_DIR="$HOME/.nvm"
  set +u; . "$NVM_DIR/nvm.sh"; set -u
fi

# 2. 已經有就不重裝
if command -v codegraph >/dev/null 2>&1; then
  echo "codegraph 已安裝,跳過"
  exit 0
fi

{{ if not (includeTemplate "node-runnable" .) -}}
# 沒有 root、系統又沒有 libatomic.so.1(.chezmoitemplates/node-runnable):Node 跑不起來,略過。
# 之後系統補上它,這段渲染結果會變,run_onchange_ 會重跑。
{{ template "sh-skip" . }}
skip_root "codegraph" "要 Node,跟著上面「nvm 與 Node」那項"
exit 0
{{ end -}}
# 3. 安裝
command -v npm >/dev/null 2>&1 || { echo "codegraph 要 npm:install-node 應該已經裝好,看它的輸出" >&2; exit 1; }
npm install -g @colbymchenry/codegraph
{{ end -}}
