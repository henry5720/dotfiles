{{- /* 選裝工具 Claude Code 的 Windows 版(#316),Linux 那支是 install-claude.sh。沒勾就渲染成空的,chezmoi 不跑。
       裝法照 ADR 0005:官方 install.ps1(https://code.claude.com/docs/en/setup#install-on-native-windows),
       裝到 %USERPROFILE%\.local\bin\claude.exe,之後自己在背景更新。installer 不改 PATH:
       PowerShell profile(pwsh 7 與 5.1 共用)已經把 $HOME\.local\bin 加進 PATH。
       讀 PDF 的 pdftoppm 由 mise 裝(.chezmoidata/packages.yaml 的 miseTools.claude)。
       由 Windows PowerShell 5.1 跑:渲染結果只能有 ASCII,中文訊息走 ps1-text。
       codex(#317)照這個結構,換掉下面兩個值;官方裝的位置在 .chezmoitemplates/ps1-agent-exe。

       1. 已經裝過就跳過。只認官方裝的位置:PATH 上的 claude 可能是 mise、winget 那份,認了就永遠裝不到官方版
       2. 下載官方腳本成檔案、在同一個 process 跑(.chezmoitemplates/ps1-official-installer)。
          官方腳本出錯是 Write-Error 加 Stop(丟例外)或 exit 1,兩種都接住。
          裝失敗只印一行、exit 0:不然 apply 中止。代價是不會自動重試,要自己照印出來的指令裝
       移除:照官方 setup 那頁 Uninstall 的 Windows PowerShell 段。 */ -}}
{{- if has "claude" (splitList " " (includeTemplate "tools-to-install" .)) -}}
{{- $name := "Claude Code" -}}
{{- $url := "https://claude.ai/install.ps1" -}}
{{ includeTemplate "ps1-text" . }}
if (Test-Path ({{ includeTemplate "ps1-agent-exe" "claude" }})) {
    Write-Host ((T '{{ "{0} 已安裝,跳過" | b64enc }}') -f '{{ $name }}')
    exit 0
}

{{ includeTemplate "ps1-official-installer" (dict "url" $url) }}
if ($code -ne 0) {
    Write-Host ((T '{{ "{0} 沒裝好,之後自己跑:irm {1} | iex" | b64enc }}') -f '{{ $name }}', '{{ $url }}')
}
exit 0
{{ end -}}
