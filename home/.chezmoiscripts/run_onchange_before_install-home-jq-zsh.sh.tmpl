{{- if includeTemplate "use-mise" . -}}
#!{{ lookPath "sh" }}
# apt 用不了的 Linux(沒有 root,或非 Debian 系;.chezmoitemplates/use-mise)把 jq 與 zsh 裝到家目錄。
# 其他機器渲染成空的:有 root 的 Debian 系、Termux 由 install-packages 用 apt／pkg 裝,macOS 走 brew。
# 這兩個不交給 mise:jq 要在 modify_ 之前就有(mise 是 after_ 才裝);zsh 用 zsh-bin,不用 conda 版
# (會帶 CONDA_PREFIX,以前 p10k 因此一直多顯示 anaconda)。
#
# 名字帶 before_:在 modify_ 腳本(要 jq)之前跑;排在 install-packages 前面,
# 沒有 root 的 Debian 系那支就不再把 jq、zsh 算成缺的套件。
# 系統已經有的不裝;用到 jq 的腳本找不到它時會把 ~/.local/bin 加進 PATH(.chezmoitemplates/sh-jq-path)。
set -eu
bin=$HOME/.local/bin

# 1. jq:jqlang/jq 官方有靜態 binary,放 ~/.local/bin。沒有它 modify_ 會失敗,所以裝不起來就讓 apply 停下來,
#    下次 apply 重試(腳本失敗不會記成跑過)。
if command -v jq >/dev/null 2>&1 || [ -x "$bin/jq" ]; then
  :
else
  case "$(uname -m)" in
    x86_64) jq_asset=amd64 ;;
    aarch64 | arm64) jq_asset=arm64 ;;
    *) echo "jq 沒有 $(uname -m) 的官方 binary,請自己裝 jq 再 chezmoi apply" >&2; exit 1 ;;
  esac
  mkdir -p "$bin"
  if curl -fsSL -o "$bin/.jq.tmp" "https://github.com/jqlang/jq/releases/latest/download/jq-linux-$jq_asset" &&
    chmod 755 "$bin/.jq.tmp" && mv -f "$bin/.jq.tmp" "$bin/jq"; then
    echo "jq 從 GitHub release 裝到 ~/.local/bin"
  else
    rm -f "$bin/.jq.tmp"
    echo "jq 下載失敗;modify_ 腳本要它,這次 apply 停在這裡,網路好了再 chezmoi apply" >&2
    exit 1
  fi
fi
{{- if has "zsh" (index . "tools") }}

# 2. zsh(勾了選裝工具 zsh 才有這段):zsh-bin 官方說不用 root、靜態連結,裝到 ~/.local(~/.local/bin/zsh)。
#    -e no:不碰 /etc/shells。安裝腳本釘版本,裡面有每個 tarball 的 sha256。
#    沒辦法 chsh,改由 ~/.bashrc 在互動式 bash 啟動時切過去(home/modify_dot_bashrc.tmpl)。
#    裝不起來不擋 apply(zsh 不是 apply 要的),印手動指令。
zsh_install='https://raw.githubusercontent.com/romkatv/zsh-bin/v6.1.1/install'
if command -v zsh >/dev/null 2>&1 || [ -x "$bin/zsh" ]; then
  :
elif zsh_bin=$(curl -fsSL "$zsh_install") && sh -c "$zsh_bin" -- -d "$HOME/.local" -e no -q; then
  echo "zsh 用 zsh-bin 裝到 ~/.local/bin"
else
  echo "zsh-bin 沒裝起來(網路?)。手動:sh -c \"\$(curl -fsSL $zsh_install)\" -- -d ~/.local -e no" >&2
fi
{{- end }}
{{ end -}}
