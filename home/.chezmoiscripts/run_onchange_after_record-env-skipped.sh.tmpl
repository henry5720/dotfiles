{{- /* 原因由裝法判斷 tool-install 照 .chezmoidata/tool-table.yaml 算(#332)。規則寫了 aptFix 時,Debian 系附上 apt 指令(ADR 0004) */ -}}
{{- $skipped := includeTemplate "tools-skipped" . -}}
{{- if $skipped -}}
{{- $status := (includeTemplate "tool-install" . | fromJson).tools -}}
#!{{ lookPath "sh" }}
# 勾了、但這台裝不了的選裝工具(選裝工具表算出裝不了的):各工具的腳本與套件清單
# 看 tools-to-install,本來就不會裝它們;這支只負責印「略過＋原因」並記進略過彙整,
# 由 run_after_zz-root-skipped-summary 在 apply 最後列出來。apply 不會因此失敗。
# 沒有裝不了的勾選就渲染成空的。run_onchange_:勾選或原因變了才再印一次。
set -eu

{{ includeTemplate "sh-skip" . }}
{{ range splitList " " $skipped -}}
{{   $fix := dig . "aptFix" (list) $status -}}
{{-   $hint := "" -}}
{{-   if and $fix (includeTemplate "is-debian" $) }}{{ $hint = printf "；apt 的指令是 sudo apt-get install -y %s" (join " " $fix) }}{{ end -}}
skip_env {{ squote . }} {{ print (dig . "reason" "" $status) $hint | squote }}
{{ end -}}
{{ end -}}
