{{- /* WSL、非 amd64、非 Debian 系、macOS 裝不了:原因寫在 .chezmoitemplates/tool-env,勾了也渲染成空的,由略過彙整列出 */ -}}
{{- if has "headless-chrome" (splitList " " (includeTemplate "tools-to-install" .)) -}}
#!{{ lookPath "sh" }}
# 選裝工具 headless Chrome(選單見 .chezmoi.toml.tmpl)。沒勾就渲染成空的,chezmoi 不跑。
# agent 在這台開 headless Chrome 用(指令見 docs/remote-access/browser.md):查原因時開在 9222 給 chrome-devtools-mcp。
# Chrome 只有官方 .deb(Ubuntu 的 chromium 是 snap)。字型由套件腳本先裝(toolPackages)。
set -eu
{{ template "sh-apt" . }}
# 1. 已經有就不重裝
if command -v google-chrome >/dev/null 2>&1; then
  echo "headless Chrome 已安裝,跳過"
  exit 0
fi

{{ if not (includeTemplate "has-root" .) -}}
# 沒有 root(.chezmoitemplates/has-root):略過,印手動方式,不讓 apply 失敗。
{{ template "sh-skip" . }}
skip_root headless-chrome "Chrome 要十幾個系統函式庫(libnss3、libgbm、libasound2…)與中文／emoji 字型,只能用 apt 裝;下載 Chrome for Testing 也一樣缺函式庫跑不起來。請有 root 的人裝 https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"
exit 0
{{ end -}}
# 2. 下載官方 .deb 再交給 apt 裝(apt 會一起裝依賴,也會加 Google 的 apt 來源讓之後跟著更新)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
deb=$tmp/google-chrome-stable_current_amd64.deb
curl -fsSL -o "$deb" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
chmod 644 "$deb"
apt_get update
apt_get install -y "$deb"
{{ end -}}
