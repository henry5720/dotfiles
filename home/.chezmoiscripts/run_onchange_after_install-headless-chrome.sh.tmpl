{{- /* 照裝法判斷(.chezmoitemplates/tool-install):Linux 走 .deb(要 Debian 系、amd64、root)。WSL、沒有 root、非 amd64、
       非 Debian 系、macOS 裝不了:原因寫在 .chezmoidata/tool-table.yaml,勾了也渲染成空的,由略過彙整列出 */ -}}
{{- $hc := index (includeTemplate "tool-install" . | fromJson).tools "headless-chrome" -}}
{{- if and $hc.install (eq $hc.method "deb") -}}
#!{{ lookPath "sh" }}
# 選裝工具 headless Chrome(選單見 .chezmoi.toml.tmpl)。沒勾就渲染成空的,chezmoi 不跑。
# agent 在這台開 headless Chrome 用(指令見 docs/how-to/remote-access/browser.md):查原因時開在 9222 給 chrome-devtools-mcp。
# Chrome 只有官方 .deb(Ubuntu 的 chromium 是 snap)。字型由套件腳本先裝(選裝工具表的依賴套件)。
set -eu
{{ template "sh-apt" . }}
# 1. 已經有就不重裝
if command -v google-chrome >/dev/null 2>&1; then
  echo "headless Chrome 已安裝,跳過"
  exit 0
fi

# 2. 下載官方 .deb 再交給 apt 裝(apt 會一起裝依賴,也會加 Google 的 apt 來源讓之後跟著更新)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
deb=$tmp/google-chrome-stable_current_amd64.deb
curl -fsSL -o "$deb" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
chmod 644 "$deb"
apt_get update
apt_get install -y "$deb"
{{ end -}}
