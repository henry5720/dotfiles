{{- if ne .chezmoi.os "android" -}}
#!{{ lookPath "sh" }}
# 預設安裝的命令列工具(不進選單):從 GitHub release 的 latest 下載到 ~/.local/bin。
# Linux 不分發行版都走這裡,只用 curl、tar;原生 Termux 用 pkg 裝(.chezmoidata/packages.yaml),這支渲染成空的。
# chezmoi 不負責更新、也不釘版本。zshrc 的 alias 與 shell 整合在 home/dot_zshrc 第 6、7 段。
#
# 「已經裝過」只看 ~/.local/bin/<工具> 在不在,不用 command -v:Ubuntu 可能有 apt 裝的舊版
# (例如 fzf 0.44 沒有 `fzf --zsh`),找到它就跳過的話,每次開 shell 都會報錯。
# 系統那份不用管,zshrc 讓 ~/.local/bin 排在 PATH 前面。
set -eu
{{ template "sh-arch" . }}
# 1. 共用開頭:架構、目的地、暫存目錄
arch=$(uname -m)
case "$arch" in
  x86_64|aarch64) ;;
  *) skip_arch "命令列工具(eza 等)" ;;
esac
bin="$HOME/.local/bin"
mkdir -p "$bin"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# 檔名帶版本號的 asset 要先知道 latest 是哪個 tag:/releases/latest 會轉址到 /releases/tag/<tag>
latest_tag() {
  url=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/$1/releases/latest")
  echo "${url##*/}"
}
# fetch <名字> <tar.gz 的 URL>:解到 $tmp/<名字>。先存檔再解,curl 失敗才會讓腳本停下來
fetch() {
  curl -fsSL -o "$tmp/$1.tar.gz" "$2"
  mkdir -p "$tmp/$1"
  tar -xzf "$tmp/$1.tar.gz" -C "$tmp/$1"
}

# 2. eza:x86_64 用靜態連結的 musl 版;aarch64 只有 glibc 版
if [ -e "$bin/eza" ]; then
  echo "eza 已安裝,跳過"
else
  case "$arch" in
    x86_64) target=x86_64-unknown-linux-musl ;;
    aarch64) target=aarch64-unknown-linux-gnu ;;
  esac
  fetch eza "https://github.com/eza-community/eza/releases/latest/download/eza_$target.tar.gz"
  install -m 755 "$tmp/eza/eza" "$bin/eza"
fi

# 3. fzf:Go 靜態 binary。tag 是 v0.xx.x,檔名裡的版本不帶 v
if [ -e "$bin/fzf" ]; then
  echo "fzf 已安裝,跳過"
else
  case "$arch" in
    x86_64) target=linux_amd64 ;;
    aarch64) target=linux_arm64 ;;
  esac
  tag=$(latest_tag junegunn/fzf)
  fetch fzf "https://github.com/junegunn/fzf/releases/download/$tag/fzf-${tag#v}-$target.tar.gz"
  install -m 755 "$tmp/fzf/fzf" "$bin/fzf"
fi

# 4. bat:靜態連結的 musl 版。指令名是 bat(apt 版叫 batcat)。tag 是 v0.xx.x,檔名也帶 v
if [ -e "$bin/bat" ]; then
  echo "bat 已安裝,跳過"
else
  tag=$(latest_tag sharkdp/bat)
  name="bat-$tag-$arch-unknown-linux-musl"
  fetch bat "https://github.com/sharkdp/bat/releases/download/$tag/$name.tar.gz"
  install -m 755 "$tmp/bat/$name/bat" "$bin/bat"
fi

# 5. ripgrep(指令 rg):靜態連結的 musl 版。tag 不帶 v
if [ -e "$bin/rg" ]; then
  echo "rg 已安裝,跳過"
else
  tag=$(latest_tag BurntSushi/ripgrep)
  name="ripgrep-$tag-$arch-unknown-linux-musl"
  fetch ripgrep "https://github.com/BurntSushi/ripgrep/releases/download/$tag/$name.tar.gz"
  install -m 755 "$tmp/ripgrep/$name/rg" "$bin/rg"
fi
{{ end -}}
