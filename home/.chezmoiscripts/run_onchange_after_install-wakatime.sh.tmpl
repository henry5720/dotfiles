{{- if has "wakatime" (index . "tools") -}}
#!{{ lookPath "sh" }}
# 選裝工具 WakaTime(選單見 .chezmoi.toml.tmpl)。沒勾就渲染成空的,chezmoi 不跑。
# 裝 wakatime-cli 與 zsh 外掛;dot_zshrc 有外掛才載入,API key 由 private_dot_wakatime.cfg.tmpl 部署。
# 同時勾了 claude、codex、code-server 的機器再裝那邊的官方 WakaTime plugin／擴充(第 4 段起)。放在這支、不另開腳本:
# 勾選組合一變,這支渲染出來的內容就變,run_onchange 會重跑,舊機器補勾也會裝到;
# 而且照檔名順序,install-claude 等腳本已經先跑完。
# wakatime-cli 抓 GitHub release,chezmoi 不負責更新它。unzip 在基底套件裡。
#
# wakatime-cli 照官方 install_cli.py 的位置放:本體 ~/.wakatime/wakatime-cli-linux-<arch>,
# 再 symlink 成 ~/.wakatime/wakatime-cli。zsh 外掛預設找這支;各編輯器的 WakaTime 外掛也用同一支、
# 還會自己更新它,已經有了就不重抓。
set -eu
{{ template "sh-arch" . }}
# 1. wakatime-cli
case "$(uname -m)" in
  x86_64) asset=amd64 ;;
  aarch64) asset=arm64 ;;
  *) skip_arch wakatime-cli ;;
esac
dir="$HOME/.wakatime"
bin="$dir/wakatime-cli-linux-$asset"
if [ -x "$bin" ]; then
  echo "wakatime-cli 已安裝,跳過"
else
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  curl -fsSL -o "$tmp/wakatime.zip" \
    "https://github.com/wakatime/wakatime-cli/releases/latest/download/wakatime-cli-linux-$asset.zip"
  unzip -q "$tmp/wakatime.zip" -d "$tmp"
  mkdir -p "$dir"
  install -m 755 "$tmp/wakatime-cli-linux-$asset" "$bin"
fi
ln -sfn "$bin" "$dir/wakatime-cli"

# 2. 舊版放在 ~/.local/bin/wakatime-cli,刪掉,只留官方位置那支
if [ -f "$HOME/.local/bin/wakatime-cli" ] && [ ! -L "$HOME/.local/bin/wakatime-cli" ]; then
  rm -f "$HOME/.local/bin/wakatime-cli"
fi

# 3. zsh 外掛
plugin="$HOME/.config/zsh/wakatime-zsh-plugin"
if [ ! -d "$plugin" ]; then
  git clone --depth=1 https://github.com/sobolevn/wakatime-zsh-plugin.git "$plugin"
fi
{{- if has "claude" (index . "tools") }}

# 4. Claude Code 的 WakaTime plugin:照 wakatime/claude-code-wakatime README 的兩行指令裝。
#    plugin 找 ~/.wakatime/wakatime-cli-linux-<arch>、讀 ~/.wakatime.cfg,跟上面放的位置一樣。
#    plugin 的 hook 用 node 跑,要勾 nvm(沒有 node 只是不送 heartbeat,不影響 Claude Code)。
#    已裝就跳過:重跑那兩行雖然也只會印「already」,但會連 GitHub。
#    chezmoi 跑腳本時的 PATH 不一定有 ~/.local/bin,所以也直接看檔案。
claude=$(command -v claude || echo "$HOME/.local/bin/claude")
if [ ! -x "$claude" ]; then
  echo "找不到 claude,跳過 Claude Code 的 WakaTime plugin"
elif "$claude" plugin list --json </dev/null | jq -e 'any(.[]; .id == "claude-code-wakatime@wakatime")' >/dev/null; then
  echo "Claude Code 的 WakaTime plugin 已安裝,跳過"
else
  "$claude" plugin marketplace add https://github.com/wakatime/claude-code-wakatime.git </dev/null
  "$claude" plugin install claude-code-wakatime@wakatime </dev/null
fi
{{- end }}
{{- if has "codex" (index . "tools") }}

# 5. Codex CLI 的 WakaTime plugin:照 wakatime/codex-cli-wakatime README 的兩行指令裝。
#    codex 會把 [marketplaces.wakatime]、[plugins."codex-cli-wakatime@wakatime"] 寫進
#    ~/.codex/config.toml;modify_private_config.toml.tmpl 原樣保留別人的 table,不會被 apply 蓋掉。
#    plugin 一樣用 ~/.wakatime 的 wakatime-cli 與 ~/.wakatime.cfg,hook 也用 node 跑。
codex=$(command -v codex || echo "$HOME/.local/bin/codex")
if [ ! -x "$codex" ]; then
  echo "找不到 codex,跳過 Codex CLI 的 WakaTime plugin"
elif "$codex" plugin list --json </dev/null | jq -e 'any(.installed[]?; .pluginId == "codex-cli-wakatime@wakatime")' >/dev/null; then
  echo "Codex CLI 的 WakaTime plugin 已安裝,跳過"
else
  "$codex" plugin marketplace add wakatime/codex-cli-wakatime </dev/null
  "$codex" plugin add codex-cli-wakatime@wakatime </dev/null
fi
{{- end }}
{{- if has "code-server" (index . "tools") }}

# 6. code-server 的 WakaTime 擴充:code-server FAQ 的 --install-extension,預設從 Open VSX 抓
#    WakaTime.vscode-wakatime。擴充跑在 server 端,用這台的 ~/.wakatime/wakatime-cli 與 ~/.wakatime.cfg。
#    code-server 不在 PATH 的話(非 apt 安裝)找 installer 的 standalone 位置。
cs=$(command -v code-server || echo "$HOME/.local/bin/code-server")
if [ ! -x "$cs" ]; then
  echo "找不到 code-server,跳過 code-server 的 WakaTime 擴充"
elif "$cs" --list-extensions </dev/null | grep -qix 'wakatime.vscode-wakatime'; then
  echo "code-server 的 WakaTime plugin 已安裝,跳過"
else
  "$cs" --install-extension WakaTime.vscode-wakatime </dev/null
fi
{{- end }}
{{ end -}}
