{{- if and (includeTemplate "is-debian" .) (has "snapclient" (splitList " " (includeTemplate "tools-to-install" .))) -}}
#!{{ lookPath "sh" }}
# 選裝工具 snapclient(選單見 .chezmoi.toml.tmpl,#292)。只有 Debian 系要跑:沒勾、這台裝不了(tool-env),
# 或是 Termux(pkg 的 snapcast-client 沒有系統服務)、macOS(brew 不自動起服務)就渲染成空的,chezmoi 不跑。
# 套件本身由 install-packages 用 apt 裝(.chezmoidata/packages.yaml 的 toolPackages)。
# 這支只做一件事:停用並關掉 apt 套件自帶的系統服務 —— 它開機自動啟動、用 _snapclient 帳號直接開 ALSA,
# 靠 mDNS 找伺服器(過不了 tailnet,區網裡有別的 snapserver 反而會自己連上去),還會跟桌面的音效伺服器搶裝置。
# 要聽時自己跑 snapclient --host <tailnet IP>,要常駐用 user service(docs/remote-access/voice-out.md)。
# 步驟在共用樣板 sh-disable-system-service。
set -eu
{{ includeTemplate "sh-disable-system-service" (dict "root" . "service" "snapclient"
     "done" "收聽朗讀:snapclient --host <tailnet IP>" "why" "它開機自動啟動、靠 mDNS 找伺服器") }}
{{ end -}}
