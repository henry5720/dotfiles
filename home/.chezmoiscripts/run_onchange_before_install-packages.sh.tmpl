{{- if or (includeTemplate "is-debian" .) (eq .chezmoi.os "android") -}}
#!{{ lookPath "sh" }}
# 裝 .chezmoidata/packages.yaml 列的基本套件。Debian 系 Linux 走 apt-get,原生 Termux(os 是 android)走 pkg。
# 其他 Linux 渲染成空的,不跑:套件名對不上,套件自己裝。
# 另外加上 tools 有勾、選裝工具表(.chezmoidata/tool-table.yaml)上這台走 apt／pkg 的選裝工具與依賴套件;
# 這台裝不了的勾了也不裝。
#
# 沒有 root 時不叫 sudo:缺的套件印一行略過(apply 最後彙整)。jq、zsh 改由 run_onchange_before_install-home-jq-zsh
# 裝到家目錄,vim 這類選裝工具照表改走 mise,都不算在缺的裡面。
#
# 名字帶 before_:一定在 externals 之前跑完(git-repo external 要外部 git),
# 也在 modify_ 腳本之前(它們要 jq、python3)。
# run_onchange_:清單沒變就不會再跑;清單變了才重跑,而且只裝缺的。
set -eu

# 1. 算出缺哪些套件;一個都不缺就結束(不叫 sudo、不連 mirror)。Termux 也是 dpkg。
missing=""
{{- /* 選裝工具的套件照裝法判斷(.chezmoitemplates/tool-install,#333)的 lists.apt、lists.pkg:勾了、這台裝得了、
       裝法是 apt／pkg 的工具與依賴套件;誰走 apt、pkg 寫在 .chezmoidata/tool-table.yaml。
       沒有 root 時 apt 用不了,判斷已經把選裝工具改到別的裝法(zsh 的 zsh-bin、vim 這類的 mise)或標裝不了;
       只剩依賴套件(node 的 libatomic1,lists.aptNeedsRoot)照樣列:依賴裝不了不擋工具,執行時缺了才印手動指令。 */}}
{{- $install := includeTemplate "tool-install" . | fromJson }}
{{- $pkgs := .packages.ubuntu }}
{{- $tool := concat $install.lists.apt $install.lists.aptNeedsRoot }}
{{- /* Termux 的 Node(nodejs-lts)跟 nodejs、nodejs-current 互斥:不看 dpkg,執行時已經有 node 指令就不裝(下面另外判斷) */}}
{{- $termuxNode := list }}
{{- if eq .chezmoi.os "android" }}
{{-   $pkgs = .packages.termux }}
{{-   $node := $install.tools.node }}
{{-   if and $node.install (eq $node.method "pkg") }}{{ $termuxNode = $node.packages }}{{ end }}
{{-   $tool = list }}
{{-   range $install.lists.pkg }}{{ if not (has . $termuxNode) }}{{ $tool = append $tool . }}{{ end }}{{ end }}
{{- else if not (includeTemplate "has-root" .) }}
{{- /* apt 用不了時 jq 改裝到家目錄(run_onchange_before_install-home-jq-zsh),這裡不算缺 */}}
{{-   $pkgs = without $pkgs "jq" }}
{{- end }}
{{- $pkgs = concat $pkgs $tool }}
for pkg in {{ $pkgs | uniq | join " " }}; do
  dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' \
    || missing="$missing $pkg"
done
{{- if $termuxNode }}
# Termux 的 Node:nodejs-lts 跟 nodejs、nodejs-current 互斥,已經有 node 指令就不裝
command -v node >/dev/null 2>&1 || missing="$missing {{ $termuxNode | join " " }}"
{{- end }}
[ -n "$missing" ] || exit 0

# 2. 有缺才裝
echo "安裝缺少的套件:$missing"
{{ if eq .chezmoi.os "android" -}}
# Termux 不支援部分升級(新套件可能連到比已裝的更新的 library),官方建議裝新套件前先 upgrade。
# 走到這裡代表確定有缺的套件要裝(第 1 步一個都不缺就結束了),所以不是每次 apply 都升級。
# --force-confold:遇到改過的設定檔保留現有的,不跳互動提示。
DEBIAN_FRONTEND=noninteractive pkg upgrade -y -o Dpkg::Options::=--force-confold
# shellcheck disable=SC2086 # 要拆成多個參數
DEBIAN_FRONTEND=noninteractive pkg install -y $missing
{{- else if includeTemplate "has-root" . }}
{{ template "sh-apt" . }}
# 只 install 不 upgrade:apply 不該在沒預期的時候升級整台機器,安全更新交給 unattended-upgrades。
apt_get update
# shellcheck disable=SC2086 # 要拆成多個參數
apt_get install -y $missing
{{- else }}
# 沒有 root(.chezmoitemplates/has-root):apt 用不了,缺的套件略過、印缺哪些與 apt 的指令,apply 繼續。
# jq、zsh 不在這裡(第 1 步已經排除),由 run_onchange_before_install-home-jq-zsh 裝到家目錄。
{{ template "sh-skip" . }}
skip_root 系統套件 "沒裝$missing(apt 裝到系統要 root);apt 的指令是 sudo apt-get install -y$missing"
{{- end }}
{{ end -}}
