{{- if has "agent-config" (index . "tools") -}}
#!{{ lookPath "sh" }}
# config.yaml 釘的 targets、extras 兩段(.chezmoitemplates/skillshare-pinned,照勾的 client 產生)
# 或 modify_config.yaml.tmpl 本身改了,就讓 skillshare 照新的設定重新同步。
# 只有 config.yaml 換掉不會動到各 client 那份:新勾的 client 要 sync 才拿到 skills、MCP,
# 指令檔要 sync extras 才會建、改、拆連結;有這支,勾選或「改連到哪」只要 chezmoi apply 一步。
# hash: {{ include "dot_config/skillshare/modify_config.yaml.tmpl" | sha256sum }}
# pinned: {{ includeTemplate "skillshare-pinned" . | sha256sum }}
#
# 新機器上 install-agent-config(字母序在前)的 sync --all 已經做過,這裡再跑一次無害。
set -eu

ss=$HOME/.local/bin/skillshare
if [ ! -d "$HOME/.config/skillshare/.git" ] || [ ! -x "$ss" ]; then
  echo "agent-config 還沒裝好,跳過 skillshare sync"
  exit 0
fi
"$ss" sync --all
{{ end -}}
