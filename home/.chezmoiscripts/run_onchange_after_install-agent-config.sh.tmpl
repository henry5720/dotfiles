{{- if has "agent-config" (index . "tools") -}}
#!{{ lookPath "sh" }}
# 選裝工具 agent-config(選單見 .chezmoi.toml.tmpl)。沒勾就渲染成空的,chezmoi 不跑。
# skillshare 把 agent-config repo 的 skills 裝進 Claude／Codex、MCP 寫進三個 client。
# 指令檔(CLAUDE.md／AGENTS.md、commit 指引)的 symlink 由 chezmoi 的 symlink_ 模板放,
# 指到 ~/.config/skillshare/instructions/;新機器上它們先懸空,等這支 clone 完 agent-config 才生效。
#
# 是 after_:要等 ~/.config/skillshare/config.yaml(dot_config/skillshare/create_config.yaml)先部署,
# init 才會直接從 remote 拉。chezmoi 的 after_ 腳本一定在所有檔案部署完之後才跑。
# remote 走 HTTPS:agent-config 是公開 repo,新機器還沒放 SSH key 也 clone 得下來;
# push 由 ~/.gitconfig 的 pushInsteadOf 改走 SSH。
# AGENT_CONFIG_REMOTE 只給測試換成本機 repo 用(script/tests/e2e.sh)。
set -eu

dir=$HOME/.config/skillshare
remote=${AGENT_CONFIG_REMOTE:-https://github.com/henry5720/agent-config.git}

# 1. 已經 init 過就跳過(之後要更新用 skillshare pull)
if [ -d "$dir/.git" ]; then
  echo "agent-config 已安裝($dir),跳過。更新:skillshare pull && skillshare sync --all(指令檔的 symlink 由 chezmoi apply 放)"
  exit 0
fi

# 2. 裝 skillshare
ss=$HOME/.local/bin/skillshare
if [ ! -x "$ss" ]; then
  # 先下載再跑:接 pipe 的話 curl 失敗會被吞掉(shell 讀到空的就 exit 0),apply 看起來成功卻什麼都沒裝
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  curl -fsSL -o "$tmp/install.sh" https://raw.githubusercontent.com/runkids/skillshare/main/install.sh
  INSTALL_DIR="$HOME/.local/bin" sh "$tmp/install.sh"
fi

# 3. 從 remote init,再把 skills 與 MCP 裝進各個 client。
#    單講 sync 只同步 skills;pull/install 也不會同步 MCP,所以最後要 sync --all。
#    init 把 agent-config clone 下來後,chezmoi 先前放的指令檔 symlink 就指得到檔案了
[ -f "$dir/config.yaml" ] || { echo "找不到 $dir/config.yaml" >&2; exit 1; }
"$ss" init --git-root root --remote "$remote" --no-copy --no-skill --targets claude,codex
"$ss" install -g
"$ss" sync --all
{{ end -}}
