{{- /* Windows 主機的 app:用 winget 裝 .chezmoidata/packages.yaml 的 packages.windows.winget(mise、pwsh 7、
       Windows Terminal),加上裝法判斷(.chezmoitemplates/tool-install)算出走 winget 的選裝工具與依賴套件
       (lists.winget:tailscale、Chrome、Git、VC++ runtime;誰走 winget 寫在 .chezmoidata/tool-table.yaml)。
       CLI 不在這裡,見 install-mise.ps1。
       只部署到 Windows(.chezmoiignore:Windows 段放行 .chezmoiscripts/*.ps1,其他 OS 排除)。

       chezmoi 官方「宣告式裝套件」只有 brew bundle 的範例,沒有 winget;照同一個套法:清單 + run_onchange_ 腳本
       (https://www.chezmoi.io/user-guide/advanced/install-packages-declaratively/),清單沒變就不重跑。
       名字帶 before_:mise 要在 after_ 的 install-mise 之前裝好。
       由 Windows PowerShell 5.1 跑(.chezmoi.toml.tmpl 的 interpreters.ps1):渲染結果只能有 ASCII,
       說明都寫在這種樣板註解裡,訊息經 .chezmoitemplates/ps1-text 的 T 解 base64。

       1. 沒有 winget(App Installer)就記成裝失敗(ps1-skip 的 skip_fail)、exit 0:後面的腳本照跑,只是 app 沒裝
       2. 每個 id 先 winget list 看裝了沒,裝了就跳過(Win11 內建的 Terminal、已經手動裝的 pwsh);
          packages.yaml 的 wingetAlsoInstalledAs 列的其他 id 對到也算裝了(企業版 MSI 的 Chrome,#351)
       3. 沒裝的 winget install;tailscale 是 machine scope 的 MSI,會跳 UAC。
          裝失敗記成裝失敗、繼續下一個,最後 exit 0:不然 apply 中止,排在後面的腳本全不會跑。apply 最後列出,
          下次 apply 重跑這支(ps1-retry,ADR 0006)。基底(packages.windows.winget)也一樣只略過、不讓 apply 停:
          sh 版基底裝失敗會停(ADR 0006),Windows 的 .ps1 一向不停,排在後面的腳本(mise、agent)才跑得到 */ -}}
{{- $ids := concat .packages.windows.winget (includeTemplate "tool-install" . | fromJson).lists.winget -}}
{{- /* 幾個工具共用同一個 app(agent-config、wakatime 都要 Git.Git)時只列一次 */ -}}
{{- $ids = uniq $ids -}}
{{ includeTemplate "ps1-winps-modules" . }}
{{ includeTemplate "ps1-text" . }}
{{ includeTemplate "ps1-retry" (dict "key" "install-packages-windows" "home" .chezmoi.homeDir) }}
{{ includeTemplate "ps1-skip" . }}
$ids = @(
{{- range $i, $id := $ids }}{{ if $i }},{{ end }}
    {{ squote $id }}
{{- end }}
)
$alsoAs = @{
{{- range $id, $alts := .packages.windows.wingetAlsoInstalledAs }}{{ if has $id $ids }}
    {{ squote $id }} = @('{{ join "', '" $alts }}')
{{- end }}{{ end }}
}

if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    skip_fail ($ids -join ', ') (T '{{ "找不到 winget。從 Microsoft Store 裝「應用程式安裝程式」(App Installer)後再 chezmoi apply 會重試" | b64enc }}')
    exit 0
}

foreach ($id in $ids) {
    $installed = $false
    foreach ($name in @($id) + @($alsoAs[$id] | Where-Object { $_ })) {
        winget list --id $name --exact --accept-source-agreements *> $null
        if ($LASTEXITCODE -eq 0) { $installed = $true; break }
    }
    if ($installed) { continue }
    winget install --id $id --exact --source winget --accept-package-agreements --accept-source-agreements --disable-interactivity
    if ($LASTEXITCODE -ne 0) {
        skip_fail $id ((T '{{ "winget install 失敗,下次 chezmoi apply 會重試,或自己跑:winget install --id {0} --exact" | b64enc }}') -f $id)
    }
}
exit 0
