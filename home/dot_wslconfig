[wsl2]
# 設定你想要分配給 WSL 的記憶體上限（例如 16GB）
memory=16GB

# 設定虛擬交換記憶體的大小（選填，通常跟上面一樣或一半即可）
swap=8GB

# 限制 WSL 使用的 CPU 核心數（選填）
processors=8

# 這裡設定網路模式，讓 WSL 跟 Windows 像雙胞胎一樣共享網路
# code-server 靠這個：Windows 的 tailscaled proxy 到 localhost:8080 就能打到 WSL 裡的服務。
# 曾經擔心 Insider build 26200 的 mirrored WFP bug 要改回 NAT + portproxy，但 2026-08 在
# build 26200 上實測 Windows→WSL 的 localhost 是通的，所以維持 mirrored。
# 真的哪天撞到那個 bug，退路是註解掉這行改用 NAT + portproxy，指令見 docs/windows.md 的「WSL 網路：mirrored 與 NAT portproxy」。
networkingMode=mirrored

# 讓 WSL 自動同步 Windows 的代理伺服器設定
autoProxy=true

# WSL 的 DNS 查詢交給 Windows 代為解析（不經由 WSL 內的網路封包），VPN、公司 DNS 規則才會一起生效
dnsTunneling=true

[experimental]
# 讓 host 用自己的 LAN IP 回連 WSL 內的服務；沒這行 host 打自己外部 IP 不通，只能用 localhost
hostAddressLoopback=true
