{{- /* remote-browser(#278):在 Windows 個人電腦開一支獨立 profile 的 Chrome,經 ssh -R 把它的 9222 帶到
       已配置主機(預設 company-ec2),讓那邊的 agent 控這支 Chrome。你自己也直接在這個視窗用。
       那邊的 playwright-cli attach --cdp=http://127.0.0.1:9222 和 chrome-devtools-mcp 都接這個 port,可以開多個分頁。
       跟 Playwright 插件(personal-chrome-attach)的差別:插件接你的日常 profile、只交出一個分頁;
       這支是另一個 profile,整支交給 agent。為什麼要獨立 profile:Chrome 136 起日常 profile 不能開 debug port。
       用法見 docs/browser-via-ec2.md〈你要用、讓 agent 控你的瀏覽器〉。

       只部署到 Windows(.chezmoiignore 的 Windows 段放行、其他 OS 排除)。PowerShell profile 把 $HOME\.local\bin
       加進 PATH,打 remote-browser 就會跑這支。渲染結果只用 ASCII(5.1 讀沒有 BOM 的檔用 ANSI 字碼頁),
       中文訊息走 .chezmoitemplates/ps1-text。

       ssh 用的是 Windows 自己的 ~/.ssh/config(chezmoi 不部署到 Windows):那裡要有連得到已配置主機的 Host,
       預設叫 company-ec2;叫別的名字就 remote-browser <Host>。

       1. 9222 已經是 Chrome 就沿用;被別的程式佔著就停
       2. 沒有就開獨立 profile 的 Chrome,等 9222 起來
       3. 前景跑 ssh -R,Ctrl+C 只斷轉發,Chrome 和登入留著 */ -}}
param([string]$SshHost = 'company-ec2')
{{ includeTemplate "ps1-text" . }}
$ErrorActionPreference = 'Stop'
$Port = 9222
{{/* 獨立 profile 放這裡;登入、書籤都留在這個資料夾,下次開還在 */ -}}
$ProfileDir = Join-Path $env:LOCALAPPDATA 'remote-browser'

function Test-Devtools {
  {{/* 回傳 'chrome'(9222 是 Chrome)、'other'(有東西在聽但不是 Chrome)、'none'(沒人在聽) */ -}}
  try {
    $v = Invoke-RestMethod -Uri "http://127.0.0.1:$Port/json/version" -TimeoutSec 2
    if ($v.webSocketDebuggerUrl -like 'ws://*') { return 'chrome' }
    return 'other'
  } catch {
    if ($_.Exception.Response) { return 'other' }
    return 'none'
  }
}

{{/* 1. 已經在跑就沿用。這步是必要的:Chrome 已有這個 profile 的實例時,再帶參數啟動會被轉交給 */ -}}
{{/*    既有實例、新參數整組被忽略而且不報錯,9222 就永遠不會起來 */ -}}
$state = Test-Devtools
if ($state -eq 'other') {
  Write-Host ((T '{{ "127.0.0.1:{0} 被別的程式佔著,不是 Chrome。用 netstat -ano | findstr :{0} 查是誰。" | b64enc }}') -f $Port) -ForegroundColor Red
  exit 1
}

{{/* 2. 開獨立 profile 的 Chrome */ -}}
if ($state -eq 'none') {
  $chrome = @(
    "$env:ProgramFiles\Google\Chrome\Application\chrome.exe",
    "${env:ProgramFiles(x86)}\Google\Chrome\Application\chrome.exe",
    "$env:LOCALAPPDATA\Google\Chrome\Application\chrome.exe"
  ) | Where-Object { Test-Path $_ } | Select-Object -First 1
  if (-not $chrome) {
    Write-Host (T '{{ "找不到 chrome.exe。先裝 Chrome:winget install --id Google.Chrome -e" | b64enc }}') -ForegroundColor Red
    exit 1
  }
  Start-Process -FilePath $chrome -ArgumentList @(
    "--remote-debugging-port=$Port",
    "--user-data-dir=`"$ProfileDir`"",
    '--no-first-run',
    '--no-default-browser-check'
  )
  $deadline = (Get-Date).AddSeconds(15)
  while ((Test-Devtools) -ne 'chrome') {
    if ((Get-Date) -gt $deadline) {
      Write-Host ((T '{{ "等了 15 秒,127.0.0.1:{0} 還是沒起來。可能是 remote-browser 的 Chrome 已經開著、但當初沒帶 debug port:把那個視窗關掉再跑一次。" | b64enc }}') -f $Port) -ForegroundColor Red
      exit 1
    }
    Start-Sleep -Milliseconds 500
  }
  Write-Host ((T '{{ "開好了:獨立 profile 的 Chrome({0})。" | b64enc }}') -f $ProfileDir)
} else {
  Write-Host ((T '{{ "127.0.0.1:{0} 已經是 Chrome,沿用它。" | b64enc }}') -f $Port)
}

{{/* 3. 前景轉發。一個 port 同時只能一條:另一台電腦開著、或那邊的 headless Chrome 佔著 9222, */ -}}
{{/*    ExitOnForwardFailure 讓 ssh 直接結束,不會默默連上卻沒有轉發 */ -}}
if (-not (Get-Command ssh -ErrorAction SilentlyContinue)) {
  Write-Host (T '{{ "找不到 ssh。Windows 設定 > 系統 > 選用功能 加「OpenSSH 用戶端」。" | b64enc }}') -ForegroundColor Red
  exit 1
}
Write-Host ((T '{{ "轉發 9222 到 {0} 中,那邊的 agent 會用這支 Chrome。按 Ctrl+C 斷開(Chrome 留著)。" | b64enc }}') -f $SshHost)
try {
  ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 `
    -R "127.0.0.1:${Port}:127.0.0.1:${Port}" $SshHost
  if ($LASTEXITCODE -ne 0) {
    Write-Host ((T '{{ "轉發斷了(ssh exit {0})。訊息有 remote port forwarding failed:{1} 的 9222 被佔著,另一台還開著 remote-browser,或那邊在跑 remote-chrome-headless。" | b64enc }}') -f $LASTEXITCODE, $SshHost) -ForegroundColor Red
    exit 1
  }
} finally {
  Write-Host (T '{{ "轉發已關。Chrome 和登入留著,下次跑 remote-browser 會沿用。" | b64enc }}')
}
