#!/usr/bin/env python3
"""把 agent 的最後一則回覆唸到朗讀服務(選裝工具 snapserver,#291)。

    voice-out-speak [--background] < stop-hook.json

stdin 是一則 Stop hook JSON(Claude Code、Codex 都有 last_assistant_message),唸那一欄。
服務沒開(voice-out off)時立刻結束、什麼都不做,exit 0;沒東西可唸也是 exit 0。
TTS 失敗(沒網路)exit 1,絕不回 2:Stop hook exit 2 會擋住 agent 結束。

語速、聲音、長度上限照朗讀設定(~/.config/voice-out/settings,voice-out rate／voice／max 改),每則重讀;
正在寫 pipe 時 PID 記在 playing.pid,voice-out skip 送 SIGTERM 就停止這則(排隊的照唸)。
同一個 session(Stop hook JSON 的 session_id)有新回覆時,舊的不唸了(#296),見 Reply。

寫進 pipe 的速度等於播放速度(9 秒語音寫 9 秒),所以 hook 要嘛設成 async,
要嘛加 --background:讀完 stdin、確認服務在跑就回來,剩下的在背景做(錯誤寫到 speak.log)。

環境變數(測試用):
  VOICE_OUT_FIFO  snapserver 的輸入 pipe,預設 ~/.local/state/voice-out/snapfifo
  VOICE_OUT_TTS   換掉 TTS 的指令:stdin 是要唸的文字,stdout 是 48000:16:2 的 PCM
說明:dotfiles 的 docs/remote-access/voice-out.md。
"""
import fcntl
import hashlib
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

VOICE = "zh-TW-HsiaoChenNeural"
LIMIT = 600  # 約 2 分鐘語音;再長就去看畫面
# 朗讀設定:voice-out rate／voice／max 寫的 key=value,chezmoi 不管這個檔(apply 不會蓋掉)。每則回覆重讀
SETTINGS = Path.home() / ".config/voice-out/settings"
LOG_LIMIT = 1024 * 1024  # speak.log 超過就清空
OPEN_TIMEOUT = 0.5  # snapserver 每 100 ms 開一次 pipe,等 5 輪
# 預設位置跟 snapserver.conf.tmpl 的 source、voice-out.service 的 ExecStartPre 寫死的目錄一致,改位置三處一起改
FIFO = Path(os.environ.get("VOICE_OUT_FIFO") or Path.home() / ".local/state/voice-out/snapfifo")


class TTSError(Exception):
    pass


class Skipped(Exception):
    pass


def skipped(signum, frame):
    raise Skipped


def load_settings():
    """朗讀設定 → {"voice", "rate", "max"};沒有檔案、值不合格式(手改壞了)都用預設,不能讓整則不出聲。
    格式跟 voice-out 寫入前檢查的一樣;max 0 = 不限。"""
    values = {}
    try:
        for line in SETTINGS.read_text(encoding="utf-8").splitlines():
            key, _, value = line.partition("=")
            values[key.strip()] = value.strip()
    except OSError:
        pass
    voice = values.get("voice", "")
    rate = values.get("rate", "")
    limit = values.get("max", "")
    return {
        "voice": voice if re.fullmatch(r"[A-Za-z]{2,3}-[A-Za-z]+(-[A-Za-z]+)*Neural", voice) else VOICE,
        "rate": rate if re.fullmatch(r"[+-]\d+%", rate) else None,
        "max": int(limit) if limit.isascii() and limit.isdigit() else LIMIT,  # ² 這類 isdigit() 但 int() 不收
    }


def read_hook():
    """stdin 的 Stop hook JSON → (last_assistant_message, session_id);不是 JSON、沒有這欄都當空的。"""
    try:
        hook = json.load(sys.stdin)
        message, session = hook.get("last_assistant_message"), hook.get("session_id")
    except (ValueError, AttributeError):
        return "", ""
    return (message if isinstance(message, str) else "",
            session if isinstance(session, str) else "")


class Reply:
    """一則回覆在它 session 裡的先後(#296):同一個 session 的新回覆取代舊的。

    每則回覆到達時拿一個到達時間(ns),每個 session 在狀態目錄有一個檔 session-<hash>,記兩個數字:
      arrived  最晚到達的那則
      ready    最晚到達、而且語音轉好了的那則
    比自己大就是有更新的:語音轉好時、排隊拿到鎖時看 arrived(有更新的就不唸);
    正在唸時每寫一塊看 ready(更新的已經轉好、要接著唸了,就停)。

    改檔一律在 sessions.lock 的 flock 裡「讀、取最大值、寫」,os.replace 換上去,所以不會被先到的蓋回去,
    讀的人(正在唸的那則每塊讀一次,不拿鎖)也不會讀到寫一半的。檔案不在每則唸完時刪:刪了,
    還在轉語音的舊回覆就看不出有更新的。改在每次到達時清掉一天沒動的 session 檔。
    沒有 session_id(手動測試)的回覆不寫檔:不取代、也不被取代。"""

    STALE = 24 * 3600

    def __init__(self, session_id):
        self.time = time.time_ns()
        self.path = None
        if session_id:
            # session_id 不一定能當檔名
            self.path = FIFO.with_name("session-" + hashlib.sha256(session_id.encode()).hexdigest()[:16])
            self.update(arrived=True, prune=True)

    def read(self):
        """→ (arrived, ready);沒有檔案或壞了當 (0, 0)。"""
        try:
            arrived, ready = (int(n) for n in self.path.read_text().split())
            return arrived, ready
        except (OSError, ValueError):
            return 0, 0

    def update(self, arrived=False, ready=False, prune=False):
        """在鎖裡把自己的到達時間併進 arrived／ready(取最大值);ready 只在自己還是最晚到達時才寫。
        回傳寫完之後的 (arrived, ready)。"""
        with open(FIFO.with_name("sessions.lock"), "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if prune:
                self.prune()
            last_arrived, last_ready = self.read()
            if arrived:
                last_arrived = max(last_arrived, self.time)
            if ready and last_arrived <= self.time:
                last_ready = max(last_ready, self.time)
            tmp = self.path.with_name(f"{self.path.name}.tmp")
            tmp.write_text(f"{last_arrived} {last_ready}")
            os.replace(tmp, self.path)
            return last_arrived, last_ready

    def prune(self):
        now = time.time()
        for path in self.path.parent.glob("session-*"):
            try:
                if now - path.stat().st_mtime > self.STALE:
                    path.unlink()
            except OSError:
                pass

    def ready(self):
        """語音轉好了:有更晚到的就回傳 False(這則不唸),不然記下來,讓正在唸的舊回覆停下。"""
        return self.path is None or self.update(ready=True)[0] <= self.time

    def replaced(self):
        """排隊拿到鎖時:有更晚到的了。"""
        return self.path is not None and self.read()[0] > self.time

    def replaced_while_playing(self):
        """正在唸時:有更晚到、而且語音已經轉好的了。"""
        return self.path is not None and self.read()[1] > self.time


def to_speech(message, limit=LIMIT):
    """回覆 → 要唸的文字:拿掉程式碼區塊與 Markdown 符號,截斷到 limit 字元(0 = 不限)。

    唸的是給人聽的結論:程式碼區塊整段不唸;連結只唸文字、不唸網址;
    行內程式碼留內容(多半是檔名、指令名)只拿掉反引號。字中間的 - _ 不動(voice-out-speak)。"""
    text = re.sub(r"```.*?(```|$)", " ", message, flags=re.S)       # 程式碼區塊
    text = re.sub(r"!\[[^\]]*\]\([^)]*\)", " ", text)                # 圖片
    text = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", text)              # 連結 → 文字
    text = re.sub(r"https?://\S+", " ", text)                        # 裸網址
    lines = []
    for line in text.splitlines():
        line = line.strip()
        if re.fullmatch(r"[|:\-\s]*-{3,}[|:\-\s]*|[*_]{3,}", line):    # 分隔線、表格的 |---|
            continue
        line = re.sub(r"^(#{1,6}|>+|[-*+]|\d+[.)])\s+", "", line)      # 標題、引用、清單記號
        line = re.sub(r"^>+", "", line)
        lines.append(line.replace("|", " "))                         # 表格
    text = "\n".join(lines)
    text = re.sub(r"[`*]|(?<!\w)_+|_+(?!\w)|[#>\[\]]", "", text)       # 強調、行內程式碼、殘留符號
    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\s*\n\s*", "\n", text).strip()
    return (text[:limit] if limit else text).strip()


def open_pipe():
    """服務在跑就回傳 pipe 寫端的 fd,沒在跑回傳 None;最多等 OPEN_TIMEOUT 秒。

    snapserver 不是一直開著 pipe:沒有寫入者時每 100 ms 開一次、讀到 EOF 就關(strace 實測 0.34)。
    所以「現在有沒有讀者」(O_NONBLOCK 開)幾乎都是沒有;改用阻塞的 open 等它下一次輪詢,
    逾時就當服務沒開。不能無限等:服務沒開時阻塞的 open 會永遠卡住。
    pipe 不存在(服務從沒開過)open 立刻失敗,不會自己建一個普通檔案。"""
    if not FIFO.is_fifo():
        return None

    def timeout(signum, frame):
        raise TimeoutError

    old = signal.signal(signal.SIGALRM, timeout)
    signal.setitimer(signal.ITIMER_REAL, OPEN_TIMEOUT)
    try:
        return os.open(FIFO, os.O_WRONLY)
    except (TimeoutError, OSError):
        return None
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, old)


def run(cmd, label=None, **kwargs):
    try:
        return subprocess.run(cmd, check=True, stderr=subprocess.PIPE, **kwargs)
    except (OSError, subprocess.CalledProcessError) as e:
        detail = getattr(e, "stderr", None) or str(e).encode()
        raise TTSError(f"{label or Path(cmd[0]).name} 失敗:{detail.decode(errors='replace').strip()}") from e


def which(name):
    # hook 的 PATH 不一定有 ~/.local/bin 與 mise 的 shims(uv 由 mise 裝,見 .chezmoidata/packages.yaml 的 miseTools)
    home = Path.home()
    extra = os.pathsep.join(str(home / d) for d in (".local/bin", ".local/share/mise/shims"))
    return shutil.which(name) or shutil.which(name, path=extra) or name


def tts(text, out, voice=VOICE, rate=None):
    """文字 → PCM 寫進 out(檔案)。"""
    custom = os.environ.get("VOICE_OUT_TTS")
    if custom:
        run(shlex.split(custom), input=text.encode("utf-8"), stdout=out)
        return
    with tempfile.TemporaryDirectory(prefix="voice-out-") as tmp:
        txt, mp3 = Path(tmp, "text.txt"), Path(tmp, "speech.mp3")
        txt.write_text(text, encoding="utf-8")  # 用檔案傳:文字開頭是 - 也不會被當成參數
        # edge-tts 用 uv 跑,不另裝全域套件:第一次會下載到 uv 的快取(約多 1 秒),之後直接用快取、不連 PyPI
        run([which("uv"), "tool", "run", "--from", "edge-tts", "edge-tts",
             "--voice", voice, *([f"--rate={rate}"] if rate else []),  # 值以 - 開頭,要用 = 接
             "--file", str(txt), "--write-media", str(mp3)],
            label="edge-tts(uv tool run)", stdout=subprocess.DEVNULL)
        # 跟 snapserver.conf 的 sampleformat=48000:16:2 一致
        run([which("ffmpeg"), "-loglevel", "error", "-i", str(mp3), "-f", "s16le", "-ar", "48000", "-ac", "2", "-"],
            stdout=out)


def speak(text, fd, settings, reply):
    with tempfile.TemporaryFile() as pcm:
        # 語音各自先產生好(不用等前一則播完才開始轉)
        tts(text, pcm, settings["voice"], settings["rate"])
        pcm.seek(0)
        if not reply.ready():
            return
        # 排隊:寫進 pipe 這段一次一則、不交錯。鎖涵蓋整段寫入:寫入速度等於播放速度,放開鎖時前一則已經唸完。
        # flock 不保證先等的先拿到,同時到的幾則誰先唸不一定
        with open(FIFO.with_name("speak.lock"), "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if reply.replaced():
                return
            # 跳過(voice-out skip):拿著鎖的這則把 PID 寫進 playing.pid,收到 SIGTERM 就停止寫入、安靜結束。
            # 排隊等鎖、還在轉語音的不受影響
            playing = FIFO.with_name("playing.pid")
            try:
                signal.signal(signal.SIGTERM, skipped)
                playing.write_text(str(os.getpid()))
                # 一塊 64 KB(pipe 緩衝區大小)約 0.34 秒語音:同 session 的新回覆轉好後,最多再寫一塊就停;
                # 加上 pipe 裡已經寫進去的,最慢約 0.7 秒聽不到舊的(snapclient 的緩衝另計)
                while (chunk := pcm.read(65536)) and not reply.replaced_while_playing():
                    os.write(fd, chunk)
            except BrokenPipeError:
                pass  # 唸到一半服務被關掉
            except Skipped:
                pass
            finally:
                # 先刪 playing.pid 再還原 SIGTERM:反過來的話,夾在中間的 SIGTERM 會直接殺掉行程、留下舊 PID,
                # 之後 skip 可能殺到重用這個 PID 的另一則
                try:
                    if playing.read_text() == str(os.getpid()):
                        playing.unlink()
                except (OSError, Skipped):
                    pass
                signal.signal(signal.SIGTERM, signal.SIG_DFL)


def detach():
    """--background:父行程直接回去(hook 馬上結束),子行程脫離後繼續;錯誤寫到 speak.log。

    父行程等子行程 setsid 之後才 exit:Codex 的 hook 行程結束時會 kill 整個 process group,
    父行程先走的話,還沒脫離的子行程會被一起砍掉。"""
    r, w = os.pipe()
    if os.fork():
        os.close(w)
        os.read(r, 1)  # 子行程 setsid 後關掉寫端,這裡讀到 EOF
        os._exit(0)
    os.close(r)
    os.setsid()
    os.close(w)
    # speak.log 只往後加:超過 LOG_LIMIT 就從頭清空,不會無限長大
    log_path = FIFO.with_name("speak.log")
    try:
        too_big = log_path.stat().st_size > LOG_LIMIT
    except OSError:
        too_big = False
    log = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | (os.O_TRUNC if too_big else 0), 0o600)
    null = os.open(os.devnull, os.O_RDWR)
    os.dup2(null, 0)
    os.dup2(null, 1)
    os.dup2(log, 2)


def main():
    settings = load_settings()
    message, session_id = read_hook()
    text = to_speech(message, settings["max"])
    if not text:
        return 0
    fd = open_pipe()
    if fd is None:
        return 0
    # 到達的先後在前景記下(--background 之前),跟 hook 觸發的順序一致
    reply = Reply(session_id)
    if "--background" in sys.argv[1:]:
        detach()
    try:
        speak(text, fd, settings, reply)
    except TTSError as e:
        print(f"voice-out-speak:{e}", file=sys.stderr)
        return 1
    finally:
        os.close(fd)
    return 0


if __name__ == "__main__":
    sys.exit(main())
