# ===============================================================
# 1. 開場系統資訊
# ===============================================================
# 會輸出到終端，必須放在 Powerlevel10k Instant Prompt 之前。
command -v fastfetch &>/dev/null && fastfetch

# ===============================================================
# 2. Powerlevel10k 快速啟動 (Instant Prompt)
# ===============================================================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ===============================================================
# 3. 環境變數與路徑 (Path Settings)
# ===============================================================
# 如果你有使用 pnpm (Senior Engineer 標配)
export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME:$PATH"

# opencode / claude 之類的工具裝在這兩處
export PATH="$HOME/.opencode/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# 啟用 OpenCode 背景 subagents
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
# 啟用 Exa 搜尋
export OPENCODE_ENABLE_EXA=1

# MCP 用的 API key（CONTEXT7_API_KEY）。chezmoi 從本機 config 渲染，key 沒填就沒有這個檔。
[ -r "$HOME/.config/zsh/env.zsh" ] && source "$HOME/.config/zsh/env.zsh"

# snap 的指令(舊機器的 chezmoi 可能是 snap 裝的;bootstrap 現在裝到 ~/.local/bin)。
# snapd 是靠 /etc/profile.d/apps-bin-path.sh 加這條,
# 但 Ubuntu 的 /etc/zsh/zprofile 不 source /etc/profile,所以 zsh 拿不到,得自己加。
# 用 append:同名工具讓上面那些使用者自己裝的版本優先,不被 snap 蓋掉。
export PATH="$PATH:/snap/bin"

# 載入 NVM(node / npm,以及 npm -g 裝的工具,例如 codegraph)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# WakaTime shell tracking（未安裝或未設定 key 時不影響啟動）
[ -r "$HOME/.config/zsh/wakatime-zsh-plugin/wakatime.plugin.zsh" ] \
  && source "$HOME/.config/zsh/wakatime-zsh-plugin/wakatime.plugin.zsh"

# ===============================================================
# 4. 歷史紀錄設定 (History)
# ===============================================================
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

setopt SHARE_HISTORY          # 跨視窗共享紀錄
setopt APPEND_HISTORY         # 追加方式寫入
setopt INC_APPEND_HISTORY     # 立即寫入檔案
setopt HIST_IGNORE_DUPS       # 忽略重複
setopt HIST_IGNORE_SPACE      # 空格開頭不紀錄

# ===============================================================
# 5. 載入主題與個人化設定 (已搬移至 .config)
# ===============================================================
[ -f ~/.config/zsh/powerlevel10k/powerlevel10k.zsh-theme ] \
  && source ~/.config/zsh/powerlevel10k/powerlevel10k.zsh-theme
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ===============================================================
# 6. 補全系統與外掛 (Completion & Plugins)
# ===============================================================
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' # 補全忽略大小寫

# 自動建議
[ -f ~/.config/zsh/zsh-autosuggestions/zsh-autosuggestions.zsh ] \
  && source ~/.config/zsh/zsh-autosuggestions/zsh-autosuggestions.zsh

# fzf:Ctrl-R 模糊搜歷史、Ctrl-T 挑檔案、Alt-C 進子目錄、**<Tab> 模糊補全(平常 Tab 不變)。
# 要 fzf ≥ 0.48 才有 --zsh;~/.local/bin 排在 PATH 前面,不會吃到 apt 的舊版。沒裝就略過
(( $+commands[fzf] )) && source <(fzf --zsh)

# 目錄跳轉:z <片段> 跳到常去、最近去過的目錄。cd 不變,資料檔用預設的 ~/.z
[ -f ~/.config/zsh/zsh-z/zsh-z.plugin.zsh ] \
  && source ~/.config/zsh/zsh-z/zsh-z.plugin.zsh

# 語法高亮 (必須放最後)
[ -f ~/.config/zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] \
  && source ~/.config/zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# ===============================================================
# 7. 自定義別名 (Aliases)
# ===============================================================
# ls、grep 只加顏色,不換成 eza、rg(參數意思不同);cat 也不換成 bat
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# 有 eza 才用 eza 版的 ll/la/l/lt(開 shell 時判斷,裝好要開新 shell);
# 沒有就退回 Ubuntu bash 預設的 ll/la/l,lt 不定義。--icons=auto:接 pipe 時不印 icon
if (( $+commands[eza] )); then
  alias ll='eza -la --git --icons=auto --group-directories-first'
  alias la='eza -a --icons=auto --group-directories-first'
  alias l='eza -F --icons=auto --group-directories-first'
  alias lt='eza --tree --level=2 --icons=auto --group-directories-first'
else
  alias ll='ls -alF'
  alias la='ls -A'
  alias l='ls -CF'
fi

