# ===============================================================
# 0. 終端機類型
# ===============================================================
# 有些環境開 shell 時沒給 TERM:沒設才補,有設就不動。
[[ -n $TERM ]] || export TERM=xterm-256color

# ===============================================================
# 1. 開場系統資訊
# ===============================================================
# Linux 由 mise 裝,shims 已經由 ~/.zshenv 放進 PATH。
(( $+commands[fastfetch] )) && fastfetch

# ===============================================================
# 2. 背景程序與 nvm(環境變數、PATH 在 ~/.zshenv)
# ===============================================================
# userspace tailscale(沒有 root 時 install-tailscale 裝到 ~/.local/bin 的):tailscaled 不會常駐,工作區待命回來就沒了。
# 開 zsh 時沒在跑就背景起來;登入狀態在 statedir,不用重新登入。輸出全導到 log,不印到終端機。
# 只看「~/.local/bin 有 tailscaled、statedir 存在」:用系統 tailscale 的機器不會走到這裡。
if [[ -x $HOME/.local/bin/tailscaled && -d $HOME/.local/state/tailscale ]] && (( $+commands[pgrep] )) \
    && ! pgrep -xu "$UID" tailscaled >/dev/null; then
  nohup "$HOME/.local/bin/tailscaled" --tun=userspace-networking \
    --statedir="$HOME/.local/state/tailscale" \
    --socket="$HOME/.local/state/tailscale/tailscaled.sock" --port=0 \
    >>"$HOME/.local/state/tailscale/tailscaled.log" 2>&1 &!
fi

# node、npm:Linux 由 mise 裝,經 ~/.zshenv 放進 PATH 的 shims 找得到(#342)。以前 nvm 裝的 ~/.nvm 原地保留、不再載入,可以手動刪。
# macOS 照舊走 nvm(#340 Out of Scope),只在 macOS 載入
if [[ $OSTYPE == darwin* && -s $HOME/.nvm/nvm.sh ]]; then
  export NVM_DIR="$HOME/.nvm"
  \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
fi

# ===============================================================
# 3. 歷史紀錄設定 (History)
# ===============================================================
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

setopt SHARE_HISTORY          # 跨視窗共享紀錄
setopt APPEND_HISTORY         # 追加方式寫入
setopt INC_APPEND_HISTORY     # 立即寫入檔案
setopt HIST_IGNORE_DUPS       # 忽略重複
setopt HIST_IGNORE_SPACE      # 空格開頭不紀錄

# ===============================================================
# 4. 提示列 (starship)
# ===============================================================
# 選裝工具 starship 裝的,設定在 ~/.config/starship.toml(bash 用同一份,見 modify_dot_bashrc.tmpl)。
# 沒裝就用 zsh 預設的提示列。
(( $+commands[starship] )) && eval "$(starship init zsh)"

# ===============================================================
# 5. 補全系統與外掛 (Completion & Plugins)
# ===============================================================
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' # 補全忽略大小寫

# 自動建議
[ -f ~/.config/zsh/zsh-autosuggestions/zsh-autosuggestions.zsh ] \
  && source ~/.config/zsh/zsh-autosuggestions/zsh-autosuggestions.zsh

# fzf:Ctrl-R 模糊搜歷史、Ctrl-T 挑檔案、Alt-C 進子目錄、**<Tab> 模糊補全(平常 Tab 不變)。
# 要 fzf ≥ 0.48 才有 --zsh;mise shims 排在 PATH 的系統目錄前面,不會吃到 apt 的舊版。沒裝就略過。
# 沒有終端機($TTY 空,例如 ssh host 'zsh -i -c …')也略過:用不到按鍵,
# 而且它還原選項時會印「can't change option: zle」
(( $+commands[fzf] )) && [[ -n $TTY ]] && source <(fzf --zsh)

# 目錄跳轉:z <片段> 跳到常去、最近去過的目錄。cd 不變,資料檔用預設的 ~/.z
[ -f ~/.config/zsh/zsh-z/zsh-z.plugin.zsh ] \
  && source ~/.config/zsh/zsh-z/zsh-z.plugin.zsh

# 語法高亮 (必須放最後)
[ -f ~/.config/zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] \
  && source ~/.config/zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# ===============================================================
# 6. 自定義別名 (Aliases)
# ===============================================================
# ls、grep 只加顏色,不換成 eza、rg(參數意思不同);cat 也不換成 bat
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# 有 eza 才用 eza 版的 ll/la/l/lt(開 shell 時判斷,裝好要開新 shell);
# 沒有就退回 Ubuntu bash 預設的 ll/la/l,lt 不定義。--icons=auto:接 pipe 時不印 icon
if (( $+commands[eza] )); then
  alias ll='eza -la --git --icons=auto --group-directories-first'
  alias la='eza -a --icons=auto --group-directories-first'
  alias l='eza -F --icons=auto --group-directories-first'
  alias lt='eza --tree --level=2 --icons=auto --group-directories-first'
else
  alias ll='ls -alF'
  alias la='ls -A'
  alias l='ls -CF'
fi

