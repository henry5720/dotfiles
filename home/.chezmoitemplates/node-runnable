{{- /* Node 官方 binary(Linux 由 mise 裝,#342)跑不跑得起來:能就輸出 true,否則空字串。
       跑不起來時裝法判斷(tool-install)把這台算成 no-libatomic 環境,選裝工具表的規則讓 node 與走 npm backend 的工具裝不了。
       Node 要系統的 libatomic.so.1(.chezmoidata/tool-table.yaml 上 node 的依賴套件 libatomic)。有 root 的 Debian 系套件腳本會先裝好,
       直接算能;沒有 root、或非 Debian 系(沒有套件腳本)就看系統本來有沒有(ldconfig -p)。只在 Linux 用。
       在樣板裡判斷:管理員之後補裝了 libatomic1,mise 清單跟著變,下次 apply 自己補裝。 */ -}}
{{- if and (includeTemplate "has-root" .) (includeTemplate "is-debian" .) -}}
true
{{- else if trim (output "sh" "-c" "{ /sbin/ldconfig -p 2>/dev/null || ldconfig -p 2>/dev/null; } | grep -q 'libatomic\\.so\\.1' && echo true || :") -}}
true
{{- end -}}
