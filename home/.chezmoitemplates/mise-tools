{{- /* 這台要交給 mise 裝的工具:一行一項 `"<mise 工具名>" = "latest"`,沒有就是空字串。
       呼叫端用「清單是不是空的」判斷這台要不要 mise(清單檔、install-mise、.chezmoiignore)。
       Linux 與 Windows 主機列:Termux 走 pkg、macOS 走 brew。
       Windows(#275):先列 packages.windows.mise(zoxide,不看勾選),再列有勾、在 miseTools 裡的
       (沒有 apt,不看 always;這台裝不了的不算)。node 勾了列 LTS(Linux 用 nvm 裝,不在 miseTools)。
       herdr 勾了也列(#309):Linux、macOS 走官方 installer(install-herdr),放進 miseTools 的話
       沒有 apt 的 Linux 會兩邊各裝一份,所以只寫在 Windows 這段。
       snapclient 勾了也列(#326):Linux 走 apt。mise registry 沒有 Snapcast,用 github backend 點名官方 release 的
       snapclient_win64.zip;壓縮檔根目錄還有 vc_redist.x64.exe,filter_bins 只讓 snapclient.exe 上 PATH
       (https://mise.jdx.dev/dev-tools/backends/github.html#filter-bins)。它要的 VC++ runtime 見 toolPackages.windows。
       playwright-cli 勾了列 npm backend 的 @playwright/cli(#327):官方裝法是 npm 全域套件,Windows 沒有 nvm;
       Linux 照舊 npm-install-playwright-cli。
       opencode 勾了列 npm backend 的 opencode-ai(#318):OpenCode 沒有 Windows 的 install.ps1(官方 curl installer
       在 Windows 要 Git Bash),官方 OpenCode 1 文件列了 npm 與 mise。opencode-ai 只有 OpenCode 1,跟 Linux 的
       opencode.ai/install 同一個大版本(設定檔通用);mise registry 的短名 opencode 已經指到 OpenCode 2 的 @opencode/cli。
       Linux、macOS 照舊官方 installer(install-opencode)。
       codegraph 勾了列 registry 的短名 codegraph(#323):指到 aqua:colbymchenry/codegraph,裝官方 release 的
       codegraph-win32-<arch>.zip(自帶 Node runtime,不要 mise 的 Node;needs-node 在 Windows 不算它)。
       不用官方 install.ps1:它只在 PATH 放 codegraph.cmd,mise 的 shim 是 codegraph.exe,
       skillshare 同步的 MCP 設定(command: codegraph)不經 shell 也找得到。Linux 照舊 npm-install-codegraph。
       要 Node 的工具(needs-node)勾了,沒勾 node 也列 LTS:
       mise 會先裝 node 再裝 npm backend 的工具(https://mise.jdx.dev/dev-tools/backends/npm.html)。
       有勾(這台裝不了的不算,見 tools-to-install)、在 .chezmoidata/packages.yaml 的 miseTools 裡,再看那一項:
       - always:一律列(單一執行檔,不分有沒有 root、不看系統有沒有同名指令)。
       - 其他:apt 用不了(.chezmoitemplates/use-mise)而且系統找不到它的指令才列。
         「系統找得到」排除 mise 自己的目錄(shims、installs):裝過一次之後 PATH 上的 shim 不算,
         不然下次渲染就把自己裝的那份從清單拿掉。
         在樣板裡判斷:系統之後補裝了同一個指令,清單會少一項(mise 不會解除安裝,只是不再管它)。 */ -}}
{{- if eq .chezmoi.os "windows" -}}
{{- $installing := splitList " " (includeTemplate "tools-to-install" .) -}}
{{- range .packages.windows.mise }}
{{ . | quote }} = "latest"
{{- end -}}
{{- range $name, $m := .miseTools -}}
{{-   if has $name $installing }}
{{ $m.tool | quote }} = "latest"
{{-   end -}}
{{- end -}}
{{- if includeTemplate "needs-node" . }}
"node" = "lts"
{{- end -}}
{{- if has "herdr" $installing }}
"herdr" = "latest"
{{- end -}}
{{- if has "snapclient" $installing }}
"github:badaix/snapcast" = { version = "latest", asset_pattern = "snapclient_win64.zip", filter_bins = "snapclient.exe" }
{{- end -}}
{{- if has "playwright-cli" $installing }}
"npm:@playwright/cli" = "latest"
{{- end -}}
{{- if has "opencode" $installing }}
"npm:opencode-ai" = "latest"
{{- end -}}
{{- if has "codegraph" $installing }}
"codegraph" = "latest"
{{- end -}}
{{- else if eq .chezmoi.os "linux" -}}
{{- $own := joinPath .chezmoi.homeDir ".local/share/mise" -}}
{{- $noApt := includeTemplate "use-mise" . -}}
{{- $installing := splitList " " (includeTemplate "tools-to-install" .) -}}
{{- range $name, $m := .miseTools -}}
{{-   if has $name $installing -}}
{{-     if index $m "always" }}
{{ $m.tool | quote }} = "latest"
{{-     else if $noApt -}}
{{-       $p := lookPath $m.cmd -}}
{{-       if or (not $p) (hasPrefix $own $p) }}
{{ $m.tool | quote }} = "latest"
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- end -}}
