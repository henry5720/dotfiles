{{- /* chezmoi:modify-template */ -}}
{{- /*
~/.codex/config.toml 的 Windows 版(#320)。Linux、macOS、Termux 那份是 dot_codex/modify_private_config.toml.tmpl
(sh + python3),說明以那份為準;Windows 沒有 sh、python3,這份是同一個行為的 Go template 版,
那個檔的 Windows 分支用 include 原樣吐出這份,chezmoi 拿現有檔案當 .chezmoi.stdin 再執行一次。
script/tests/test_windows.py 拿同一批輸入比對兩份的輸出,改了其中一份,另一份要跟著改。
釘的值(provider、權限、commit 指引)兩邊都從 .chezmoitemplates/ 的 codex-config-top.toml、
codex-config-provider.toml、codex-commit-attribution.md 來。

跟 Linux 那份的差別:沒有 obsidian-wiki 停用 skill 那段(那包 skill 只裝在 Linux);[[skills.config]] 一樣當成自己的拿掉。

1. 讀現有 developer_instructions,只換掉 chezmoi 的區塊,使用者自己加的字留著
2. 現有內容切成 TOML statement(多行字串、多行陣列算一個):
   - 第一個 table 前:註解、空行、repo 管的 key 丟掉(會重新長出來),其餘(codex 寫的頂層 key)留著
   - [model_providers.codex-lb-gcp](含子 table)、[[skills.config]]、舊版 chezmoi 的橫幅丟掉,其餘 table 原樣留著
3. 照 Linux 的順序輸出:repo 的頂層 key、developer_instructions、留著的頂層 key、provider、留著的 table
4. 安全檢查:repo 不管的部分解析後跟現有內容一樣,不一樣就讓 apply 失敗,不寫壞檔案
樣板自己的字一律去掉 \r:Windows 的 Git 預設 core.autocrlf=true,source checkout 成 CRLF(見 skillshare 的 modify_config.yaml)。
*/ -}}
{{- $managed := list "model" "model_provider" "model_reasoning_effort" "approval_policy" "sandbox_mode" "approvals_reviewer" "developer_instructions" -}}
{{- $provider := "codex-lb-gcp" -}}
{{- $skillsMarkers := list "# 由 chezmoi 停用的 skill(obsidian-wiki 那包,見上面的 token 實測)。" "# 由 chezmoi 停用的 skill(obsidian-wiki 那包)。" -}}
{{- $markers := concat $skillsMarkers (list "# 由 chezmoi 管理的 MCP servers。" "# MCP servers managed by chezmoi.") -}}
{{- /* 記事本存過的 CRLF 檔先換成 LF 再比對與輸出:codex 自己寫 LF,第 4 步也拿換過的比 */ -}}
{{- $existing := .chezmoi.stdin | replace "\r\n" "\n" -}}
{{- /* 1. */ -}}
{{- $prior := get (fromToml $existing) "developer_instructions" | default "" -}}
{{- if not (kindIs "string" $prior) }}{{ fail "developer_instructions 必須是字串" }}{{ end -}}
{{- $prior = regexReplaceAll "(?s)(?:\n\n)?<!-- chezmoi:codex-commit-attribution:start -->.*?<!-- chezmoi:codex-commit-attribution:end -->" $prior "" -}}
{{- $guide := regexReplaceAll "\n+$" (includeTemplate "codex-commit-attribution.md" . | replace "\r" "") "" -}}
{{- $instructions := $guide -}}
{{- if $prior }}{{ $instructions = printf "%s\n\n%s" $prior $guide }}{{ end -}}
{{- /* 2. 括號只數字串與註解以外的;三引號數到偶數個才算字串結束。
       shortcut: 不是完整的 TOML lexer(例如 basic string 裡的 """),判斷錯時第 4 步會擋下來讓 apply 失敗 */ -}}
{{- $out := list -}}
{{- $preamble := "" -}}
{{- $skillsAt := -1 -}}
{{- $keep := false -}}
{{- $seen := false -}}
{{- $pending := "" -}}
{{- range $line := regexFindAll "[^\n]*\n|[^\n]+$" $existing -1 -}}
{{-   $pending = print $pending $line -}}
{{-   if or (mod (len (splitList "\"\"\"" $pending)) 2 | eq 0) (mod (len (splitList "'''" $pending)) 2 | eq 0) }}{{ continue }}{{ end -}}
{{-   $bare := regexReplaceAll "#[^\n]*" (regexReplaceAll "(?s)\"\"\".*?\"\"\"|'''.*?'''|\"(?:[^\"\\\\\n]|\\\\.)*\"|'[^'\n]*'" $pending "") "" -}}
{{-   if ne (len (splitList "[" $bare)) (len (splitList "]" $bare)) }}{{ continue }}{{ end -}}
{{-   if ne (len (splitList "{" $bare)) (len (splitList "}" $bare)) }}{{ continue }}{{ end -}}
{{-   $st := $pending -}}
{{-   $pending = "" -}}
{{-   if has (regexReplaceAll "\n+$" $st "") $markers -}}
{{-     range $_ := $out -}}
{{-       if and $out (or (not (trim (last $out))) (hasPrefix "# ===" (last $out))) }}{{ $out = initial $out }}{{ else }}{{ break }}{{ end -}}
{{-     end -}}
{{-     if and (has (regexReplaceAll "\n+$" $st "") $skillsMarkers) (lt $skillsAt 0) }}{{ $skillsAt = len $out }}{{ end -}}
{{-     $keep = false -}}
{{-     continue -}}
{{-   end -}}
{{-   if regexMatch "^[ \t]*\\[" $st -}}
{{-     $seen = true -}}
{{-     $table := regexReplaceAll "[\\[\\]\"' \t]" (regexReplaceAll "\\][ \t]*(#.*)?\n?$" $st "") "" -}}
{{-     if or (eq $table (print "model_providers." $provider)) (hasPrefix (print "model_providers." $provider ".") $table) -}}
{{-       $keep = false -}}
{{-       continue -}}
{{-     end -}}
{{-     if eq $table "skills.config" -}}
{{-       if lt $skillsAt 0 }}{{ $skillsAt = len $out }}{{ end -}}
{{-       $keep = false -}}
{{-       continue -}}
{{-     end -}}
{{-     $keep = true -}}
{{-   end -}}
{{-   if not $seen -}}
{{-     if or (not (trim $st)) (hasPrefix "#" (trim $st)) }}{{ continue }}{{ end -}}
{{-     $key := regexReplaceAll "(?s)^[ \t]*(?:\"([^\"]*)\"|'([^']*)'|([A-Za-z0-9_-]+)).*" $st "${1}${2}${3}" -}}
{{-     if not (has $key $managed) }}{{ $preamble = print $preamble $st }}{{ end -}}
{{-     continue -}}
{{-   end -}}
{{-   if $keep }}{{ $out = append $out $st }}{{ end -}}
{{- end -}}
{{- if $pending }}{{ fail "codex config 安全更新失敗: 認不出 TOML statement 的結尾" }}{{ end -}}
{{- range $_ := $out -}}
{{-   if and $out (not (trim (last $out))) }}{{ $out = initial $out }}{{ else }}{{ break }}{{ end -}}
{{- end -}}
{{- /* 3. toJson 會把 < > & 跳脫成 < 這類,換回來跟 Linux(json.dumps)一樣;都是合法的 TOML basic string。
       shortcut: 指引裡本來就有 < 這幾個字時會被換錯,第 4 步會擋下來 */ -}}
{{- $json := toJson $instructions | replace "\\u003c" "<" | replace "\\u003e" ">" | replace "\\u0026" "&" -}}
{{- $preambleText := printf "developer_instructions = %s\n%s" $json (trimAll "\n" $preamble) -}}
{{- if lt $skillsAt 0 }}{{ $skillsAt = len $out }}{{ end -}}
{{- $head := regexReplaceAll "\n+$" (slice $out 0 $skillsAt | join "") "" -}}
{{- $tail := slice $out $skillsAt | join "" | trimAll "\n" -}}
{{- $candidate := list -}}
{{- range $part := list $head $tail }}{{ if trim $part }}{{ $candidate = append $candidate $part }}{{ end }}{{ end -}}
{{- $result := printf "%s\n%s\n\n%s\n" (regexReplaceAll "\n+$" (includeTemplate "codex-config-top.toml" . | replace "\r" "") "") $preambleText (regexReplaceAll "\n+$" (includeTemplate "codex-config-provider.toml" . | replace "\r" "") "") -}}
{{- if $candidate }}{{ $result = printf "%s\n%s\n" $result (join "\n\n" $candidate) }}{{ end -}}
{{- /* 4. */ -}}
{{- $cmp := list -}}
{{- range $v := list (fromToml $existing) (fromToml $result) -}}
{{-   $providers := omit (get $v "model_providers" | default dict) $provider -}}
{{-   $v = omit $v "model_providers" "skills" -}}
{{-   range $k := $managed }}{{ $v = omit $v $k }}{{ end -}}
{{-   if $providers }}{{ $_ := set $v "model_providers" $providers }}{{ end -}}
{{-   $cmp = append $cmp (toJson $v) -}}
{{- end -}}
{{- if ne (index $cmp 0) (index $cmp 1) }}{{ fail "codex config 安全更新失敗: 非 managed TOML 設定在重寫後改變" }}{{ end -}}
{{- if ne (get (fromToml $result) "developer_instructions") $instructions }}{{ fail "codex config 安全更新失敗: Codex commit 指引未保留在頂層" }}{{ end -}}
{{- $result -}}
