{{- /* ~/.config/opencode/opencode.json 裡由這個 repo 管的部分(mcp 以外),Linux 與 Windows 共用(#318)。
       用的地方是 dot_config/opencode/modify_private_opencode.json.tmpl(modify-template,所有平台同一份,#204)。
       "mcp": {} 只是佔位,那份 modify 換成現有檔案裡的;model、small_model 跟 oh-my-opencode-slim.json 正在用的 preset。
       oh-my-opencode-slim 固定 3.0.7(oh-my-opencode-slim.json 的 autoUpdate 也關掉):3.0.8 起要 OpenCode 2.3 以上
       (package.json 的 engines),這裡還是 OpenCode 1。升 OpenCode 2 時一起解除(#407)。 */ -}}
{{- $company := include (joinPath .chezmoi.sourceDir "dot_config/opencode/oh-my-opencode-slim.json") | fromJson -}}
{{- $active := index (index $company "presets") (index $company "preset") -}}
{{- $main := index (index $active "orchestrator") "model" -}}
{{- $small := index (index $active "explorer") "model" -}}
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [{{ printf "%s/.config/opencode/commit-instructions.md" .chezmoi.homeDir | toJson }}],
  "model": {{ $main | toJson }},
  "small_model": {{ $small | toJson }},
  "permission": {
    "external_directory": {
      "*": "ask",
      {{ printf "%s**" (includeTemplate "home-repo" .) | toJson }}: "allow",
      "/tmp/**": "allow",
      "~/.local/share/chezmoi/**": "allow"
    }
  },
  "provider": {
    "codex-lb-gcp": {
      "npm": "@ai-sdk/openai",
      "name": "TeamSync",
      "options": {
        "baseURL": "https://codex.teamsync.com.tw/backend-api/codex",
        "apiKey": "{{ .codexLbApiKey }}"
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        }
      }
    }
  },
  "mcp": {},
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "plugin": [
    "opencode-wakatime",
    "oh-my-opencode-slim@3.0.7"
  ]
}
