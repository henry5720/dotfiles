{{- /* ~/.config/opencode/opencode.json 裡由這個 repo 管的部分(mcp 以外),Linux 與 Windows 共用(#318)。
       用的地方是 dot_config/opencode/modify_private_opencode.json.tmpl(modify-template,所有平台同一份,#204)。
       "mcp": {} 只是佔位,那份 modify 換成現有檔案裡的;model、agents.title(V1 的 small_model)跟 oh-my-opencode-slim.json 正在用的 preset。
       OpenCode 2 的鍵(#407):V1 的 agent、provider、plugin、permission、small_model 都標 deprecated,
       寫法照 `opencode debug config` 把 V1 設定換算出來的結果。內建 explore、general 交給 oh-my-opencode-slim 的
       replaceBuiltinSubagents(預設 true)藏起來,這裡不再關。 */ -}}
{{- $company := include (joinPath .chezmoi.sourceDir "dot_config/opencode/oh-my-opencode-slim.json") | fromJson -}}
{{- $active := index (index $company "presets") (index $company "preset") -}}
{{- $main := index (index $active "orchestrator") "model" -}}
{{- $small := index (index $active "explorer") "model" -}}
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [{{ printf "%s/.config/opencode/commit-instructions.md" .chezmoi.homeDir | toJson }}],
  "model": {{ $main | toJson }},
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": {{ printf "%s**" (includeTemplate "home-repo" .) | toJson }}, "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/chezmoi/**", "effect": "allow" }
  ],
  "providers": {
    "codex-lb-gcp": {
      "package": "aisdk:@ai-sdk/openai",
      "name": "TeamSync",
      "settings": {
        "baseURL": "https://codex.teamsync.com.tw/backend-api/codex",
        "apiKey": "{{ .codexLbApiKey }}"
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high"] }
          },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high"] }
          },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high"] }
          },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        }
      }
    }
  },
  "mcp": {},
  "agents": {
    "title": { "model": {{ $small | toJson }} }
  },
  "lsp": true,
  "plugins": [
    "opencode-wakatime",
    "oh-my-opencode-slim"
  ]
}
