{{- /* skillshare config.yaml 裡由 chezmoi 釘的兩段:targets 與 extras,照選單勾的 client 產生。
       dot_config/skillshare/modify_config.yaml.tmpl 拿它整段換掉現有的;
       run_onchange_after_sync-skillshare.sh.tmpl 拿它的 hash 判斷要不要重新 sync。
       欄位順序照 skillshare 存檔的樣子(targets 底下 skills 再 agents;extras 是 name、source、file、targets),
       段內也不放註解(它存檔會拿掉),它改寫後再 apply 才不會出現只有排版不同的 diff。
       沒有 target 時 skillshare 存成 `targets: {}`;沒有 extras 時它整段不寫,這裡也不輸出。

       targets:claude → skills 與 agents;codex → skills(Codex 的 subagent 是 TOML,native agents
       target 不能轉檔,要用時得走 extras 的 codex-agents extension);opencode 不加 target ——
       OpenCode 本來就會讀 ~/.claude/skills 與 ~/.agents/skills,再加一個同一支 skill 會出現三次。
       extras:agents-md 是一份 AGENTS.md 給各 client,Claude 讀的檔名是 CLAUDE.md;
       agent-commit 任一個 agent 都要;agent-commit、opencode-commit 的目標路徑要對上
       AGENTS.md 與 opencode.json 引用的位置。

       路徑照 OS 產生(#321),段落內只用下面 $p 的名字:
       - 來源在 skillshare 的設定目錄底下:Linux、macOS 是 ~/.config/skillshare,
         Windows 是 %AppData%\skillshare(skillshare 的 BaseDir;這裡假設 %AppData% 在家目錄底下的預設位置)
       - Windows 整串換成反斜線:skillshare 的 preserve_tilde_on_save 存檔時用 OS 的分隔符折回 ~,
         存成 ~\.claude\skills;釘成斜線的話它存一次就出 diff。~ 開頭的路徑兩種寫法它都展開得了
       - 目標(各 client 讀的位置)在 Windows 也是家目錄底下同樣的相對路徑 */ -}}
{{- $p := dict
      "dir"            "~/.config/skillshare"
      "claudeSkills"   "~/.claude/skills"
      "claudeAgents"   "~/.claude/agents"
      "codexSkills"    "~/.agents/skills"
      "claude"         "~/.claude"
      "codex"          "~/.codex"
      "opencode"       "~/.config/opencode"
      "opencodeRoute"  "~/.config/opencode/routes/personal"
      "agentCommit"    "~/.config/agent-commit" -}}
{{- if eq .chezmoi.os "windows" }}{{ $_ := set $p "dir" "~/AppData/Roaming/skillshare" }}{{ end -}}
{{- $_ := set $p "instructions" (printf "%s/instructions/" $p.dir) -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   range $k, $v := $p }}{{ $_ := set $p $k (replace "/" "\\" $v) }}{{ end -}}
{{- end -}}
{{- $tools := index . "tools" -}}
{{- $claude := has "claude" $tools -}}
{{- $codex := has "codex" $tools -}}
{{- $opencode := has "opencode" $tools -}}
{{- if or $claude $codex }}
targets:
{{- if $claude }}
  claude:
    skills:
      path: {{ $p.claudeSkills }}
    agents:
      path: {{ $p.claudeAgents }}
{{- end }}
{{- if $codex }}
  codex:
    skills:
      path: {{ $p.codexSkills }}
{{- end }}
{{- else }}
targets: {}
{{- end }}
{{- if or $claude $codex $opencode }}
extras:
  - name: agents-md
    source: {{ $p.instructions }}agents-md
    file: AGENTS.md
    targets:
{{- if $claude }}
      - path: {{ $p.claude }}
        as: CLAUDE.md
{{- end }}
{{- if $codex }}
      - path: {{ $p.codex }}
{{- end }}
{{- if $opencode }}
      - path: {{ $p.opencode }}
      - path: {{ $p.opencodeRoute }}
{{- end }}
  - name: agent-commit
    source: {{ $p.instructions }}agent-commit
    file: instructions.md
    targets:
      - path: {{ $p.agentCommit }}
{{- if $opencode }}
  - name: opencode-commit
    source: {{ $p.instructions }}opencode-commit
    file: commit-instructions.md
    targets:
      - path: {{ $p.opencode }}
{{- end }}
{{- end }}
