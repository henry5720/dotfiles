# 依機器種類排除。路徑是 target 名稱(去掉 dot_、run_once_after_ 這類前綴與 .tmpl)。
# 腳本放在 .chezmoiscripts/,target 名稱要帶這層目錄,只寫檔名會擋不到。
{{ if eq .chezmoi.os "windows" }}
# ===============================================================
# 1. Windows:白名單,只部署下面 ! 放行的 target
# ===============================================================
# 之後新增的 Linux 設定不會意外跑到 Windows;.chezmoiscripts/ 也整個排除,Windows 不跑任何 run_ 腳本
# (都是 sh、python3)。以後 Windows 真的要腳本,寫成 .ps1 再在這裡放行。
# 寫法(chezmoi v2.74.0 實測,#254):每層深度各排除一次,排到第 6 層
# (Terminal 的 AppData/Local/Packages/<套件>/LocalState/settings.json);只寫 * 或 **/* 放不出巢狀檔案。
# 放行時每一層父目錄和檔案本身都要寫:只放行父目錄,它底下的其他檔案會漏出來。
# 加一個 Windows 檔案:在下面放行它和它的每一層父目錄,再加進 script/tests/test_windows.py 的 WINDOWS_TARGETS。
*
*/*
*/*/*
*/*/*/*
*/*/*/*/*
*/*/*/*/*/*
!.wslconfig
!.config
!.config/starship.toml
# PowerShell profile:pwsh 7 與 5.1 各一份,內容都是 .chezmoitemplates/powershell-profile.ps1
!Documents
!Documents/PowerShell
!Documents/PowerShell/Profile.ps1
!Documents/WindowsPowerShell
!Documents/WindowsPowerShell/Profile.ps1
{{ else }}
# ===============================================================
# 2. Linux、macOS、Termux
# ===============================================================
# Windows 專屬的 target(PowerShell profile、Windows Terminal、WSL 設定)不部署。
Documents
AppData
.wslconfig
{{ if not (has "zsh" (index . "tools")) }}
# 沒勾選裝工具 zsh:不部署 zsh 設定檔(外掛在 .chezmoiexternal.toml.tmpl 也一起不下載,
# 改預設 shell 的腳本渲染成空的)。已經部署過的不會被刪,跟「取消勾選不會解除安裝」一致。
.zshrc
.config/zsh/env.zsh
{{ end }}
{{ if not (has "starship" (index . "tools")) }}
# 沒勾 starship:不部署它的設定(zsh、bash 沒裝 starship 就用 shell 預設的提示列)。
.config/starship.toml
{{ end }}
{{ $bashToZsh := includeTemplate "bash-to-zsh" . -}}
{{ if not (or $bashToZsh (has "starship" (index . "tools"))) }}
# .bashrc 由 modify_dot_bashrc.tmpl 加段落,兩種情況才要:
# - 勾了 starship:互動式 bash 啟用 starship 提示列。
# - apt 用不了的 Linux(沒有 root,或非 Debian 系;.chezmoitemplates/use-mise)、勾了 zsh:
#   zsh 是 zsh-bin 裝到家目錄的,改由互動式 bash 切 zsh。
.bashrc
{{ end }}
{{ if not $bashToZsh }}
# 補 .profile 只為了上面「互動式 bash 切 zsh」那種機器。有 root 的 Debian 系、Termux 走 chsh
# (run_once_after_set-default-shell),macOS 不改,都不碰它。
.profile
{{ else if or (stat (joinPath .chezmoi.homeDir ".bash_profile")) (stat (joinPath .chezmoi.homeDir ".bash_login")) }}
# 已經有 ~/.bash_profile 或 ~/.bash_login:login bash 讀的是它們、不讀 .profile,補了也沒用,不補。
.profile
{{ end }}
{{ if eq .chezmoi.os "android" }}
# 原生 Termux:移除舊 chezmoi MCP 條目的一次性遷移只對已經部署過舊版的 Ubuntu 機器有意義,
# 而且要 python3;Termux 是新機器,排除掉。
.chezmoiscripts/remove-chezmoi-mcp.py
{{ else }}
# 只有原生 Termux 要的:給 xfce 終端機(fontconfig)看的字型 symlink。
# 排除整個目錄,不然 chezmoi 會在其他機器建出空的 ~/.local/share/fonts。
.local/share/fonts
{{ end }}

# 沒勾的 client 不部署它的設定目錄;取消勾選時,已經部署的檔案留著(chezmoi 只是不再管它)。
# skillshare 的 config.yaml 跟著 agent-config,連到各 client 的指令檔見 .chezmoitemplates/skillshare-pinned。
{{ $tools := index . "tools" -}}
{{ if not (has "claude" $tools) }}.claude{{ end }}
{{ if not (has "codex" $tools) }}.codex{{ end }}
{{ if not (has "opencode" $tools) }}.config/opencode{{ end }}
{{ if not (has "agent-config" $tools) }}.config/skillshare{{ end }}
# code-server 的設定要 codeServerPassword,沒勾 code-server 的機器不會問、config 裡也沒有(見 .chezmoi.toml.tmpl)。
{{ if not (has "code-server" $tools) }}.config/code-server{{ end }}

# 沒有工具要交給 mise 的機器(Termux、macOS、Linux 上一個都沒勾):不部署它的清單,也不建空的 ~/.config/mise。
{{ if not (includeTemplate "mise-tools" .) }}.config/mise{{ end }}
{{ end }}
