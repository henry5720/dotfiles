# 由 dotfiles 補上(apt 用不了的 Linux、勾了 zsh,而且原本沒有 ~/.profile、~/.bash_profile、~/.bash_login)。
# login bash(例如 bash -l 開的工作區)只讀這三個之一、不讀 ~/.bashrc。

# 1. ~/.local/bin 加進 PATH(跟 Ubuntu skel 的 .profile 一樣,存在才加):chezmoi、jq、zsh-bin 都裝在這裡
if [ -d "$HOME/.local/bin" ]; then
  PATH="$HOME/.local/bin:$PATH"
fi

# 2. 轉去讀 ~/.bashrc,互動式的就會在那裡切到 zsh
if [ -n "${BASH_VERSION:-}" ] && [ -f "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi
