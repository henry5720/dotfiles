# git 身分與這台機器的設定。chezmoi 納管,值在 chezmoi init 時問
# (存在 ~/.config/chezmoi/chezmoi.toml,不進這個公開 repo)。
#
# 為什麼身分放這裡而不是 ~/.config/git/config:git 兩份都讀,~/.gitconfig 後讀、
# 會贏。同一個 key 寫兩邊只會讓人猜哪份生效,所以身分只留這一份。
# ~/.config/git/config 那份專放不涉及身分的共用設定(hooks 的 includeIf)。
#
# ⚠️ `git config --global ...` 會直接改家目錄這份,不會回到 repo。
# 真的動了就 `chezmoi re-add ~/.gitconfig` 收回來。
[user]
	email = {{ .gitUserEmail }}
	name = {{ .gitUserName }}
[core]
	editor = vim
# GitHub 的 repo 用 HTTPS clone／pull(公開 repo 不用 key,新機器還沒放 key 也能 chezmoi init／update),
# push 時才改走 SSH(~/.ssh/config 的 github.com 用 ~/.ssh/henry5720)。
# 用 pushInsteadOf 而不是 insteadOf:insteadOf 連 clone 都會改寫成 SSH,沒 key 的新機器就 clone 不了。
# 本來 remote 就是 git@ 的舊機器不受影響。見 git-config(1) 的 url.<base>.pushInsteadOf。
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
