# ===============================================================
# 1. GitHub
# ===============================================================
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/henry5720

# ===============================================================
# 2. Tailscale 節點 (Tailscale devices)
# ===============================================================
# Windows 端要跑 OpenSSH server,admin 金鑰必須放在
#   C:\ProgramData\ssh\administrators_authorized_keys
Host henry-laptop
    HostName 100.97.54.0
    User henry
    IdentityFile ~/.ssh/henry5720

Host henry-desktop
    HostName 100.119.136.27
    User henry
    IdentityFile ~/.ssh/henry5720

Host nettop
    HostName 100.111.46.87
    User henry
    IdentityFile ~/.ssh/henry5720

# ===============================================================
# 3. Android (只有 Termux sshd)
# ===============================================================
# 原生 Android 沒有 sshd,需要 Termux + openssh 且 sshd 有在跑。
# Termux 聽 8022(非 root 綁不了 22);User 是 Termux 配給的 u0_aXXX。
Host pad
    HostName 100.102.9.79
    User u0_a301
    Port 8022
    IdentityFile ~/.ssh/henry5720

# LocalForward 左邊在「本機」開 port,右邊的 localhost 在「phone 上」解析,
# 也就是把 phone 的服務搬到本機 http://localhost:<port>。
# server 必須綁 127.0.0.1 才連得到。
# 連線中要臨時加 port:換行後按 ~C ,輸入  -L 5173:localhost:5173
Host phone
    HostName 100.94.24.13
    User u0_a358
    Port 8022
    IdentityFile ~/.ssh/henry5720
    LocalForward 8080 localhost:8080
    LocalForward 3000 localhost:3000
    LocalForward 3001 localhost:3001
    LocalForward 3002 localhost:3002
    ServerAliveInterval 30
    ServerAliveCountMax 3

# ===============================================================
# 4. Oracle VPS — tenancy A (我的)
# ===============================================================
# 這節和第 5 節是兩個不同的 Oracle 帳號(tenancy),各自有一份獨立的 Always Free
# 額度,分開算。Host 名不一定等於 OCI Console 上的 display name,每台在自己那段
# 註解標出 Console 上叫什麼,免得再搞混。
# 判斷某台屬於哪個帳號,登進去跑:
#   curl -sH "Authorization: Bearer Oracle" \
#     http://169.254.169.254/opc/v2/instance/ | jq -r .compartmentId
#   tenancy A = ...z3lry3...   tenancy B = ...7yh5zf...
#
# A1 額度(2 OCPU / 12 GB)全開給下面這一台。E2.1.Micro 額度(上限 2 台)是空的。

# Console display name:a1-2c12g。A1 Flex,2 OCPU / 12 GB,AD-2 / FD-1。
# 跑著 keepalive(~/bin/oci-keepalive.sh,crontab @reboot 起)防閒置回收,
# oracle-toolkit 的預設週期 3s/7s,實測整機 31% CPU(判定門檻是 20%)。
Host henry-a1
    HostName 129.80.13.225
    User ubuntu
    IdentityFile ~/.ssh/henry5720

# ===============================================================
# 5. Oracle VPS — tenancy B (別人的,不要動)
# ===============================================================
# 兩台 A1 各 1 OCPU / 6 GB,把 B 的 A1 額度佔滿了(2/2 OCPU、12/12 GB)。

# a1-fleet-1,跑 hermes gateway + ollama + nginx
Host hermes
    HostName 150.136.179.96
    User henry
    IdentityFile ~/.ssh/henry5720
    IdentitiesOnly yes

# a1-fleet-2,跑 openab-codex / openab-patrick / openab-claude 三個 container
# User 是 ubuntu 不是 henry,原本寫 henry 一直 Permission denied
Host openab
    HostName 158.101.108.0
    User ubuntu
    IdentityFile ~/.ssh/henry5720
    IdentitiesOnly yes

# 另一個拿掉的舊 Host:oracle-2 = 129.159.185.160。它也在 tenancy B,是
# 2026-07-20 前的舊 hermes micro(instance-20260709-1122),不是我的,別終止它。

# ===============================================================
# 6. 公司 AWS EC2
# ===============================================================
# 走 tailnet。一般連線不帶任何轉發:遠端的 port 只有一個位子,每條連線都帶的話
# 先連的搶到、其他默默失敗(以前 9222 轉發就是這樣)。要轉發另開 Host,只在要用時連。
Host company-ec2
    HostName 100.98.146.109
    User ubuntu
    IdentityFile ~/.ssh/company-henry.pem
    IdentitiesOnly yes
{{- if includeTemplate "tailscale-userspace" . }}
    # 這台的 tailscale 走 userspace(沒有 root,見 .chezmoitemplates/tailscale-userspace),
    # 沒有 tailnet 的網卡,連線經 tailscaled 轉過去。tailscaled 怎麼啟動見 apply 的略過彙整
    ProxyCommand {{ .chezmoi.homeDir }}/.local/bin/tailscale --socket={{ .chezmoi.homeDir }}/.local/state/tailscale/tailscaled.sock nc %h %p
{{- end }}

# 要 agent 接上這台日常的 Chrome(passkey、硬體金鑰、裝置 SSO)時才連:`ssh -N company-ec2-attach`。
# EC2 上的 personal-chrome-attach(agent-config 的 personal-pc-tunnel skill)把 Playwright Extension
# 的 relay 固定在 127.0.0.1:9555,這條把本機的 9555 接過去。不放進一般的 company-ec2:本機的 9555 也只有
# 一個位子,每條連線都帶的話第二條起就搶不到。位子被另一個視窗占著就直接失敗,不默默連上。
Host company-ec2-attach
    HostName 100.98.146.109
    User ubuntu
    IdentityFile ~/.ssh/company-henry.pem
    IdentitiesOnly yes
    LocalForward 127.0.0.1:9555 127.0.0.1:9555
    ExitOnForwardFailure yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
{{- if includeTemplate "tailscale-userspace" . }}
    ProxyCommand {{ .chezmoi.homeDir }}/.local/bin/tailscale --socket={{ .chezmoi.homeDir }}/.local/state/tailscale/tailscaled.sock nc %h %p
{{- end }}

# 網站擋機房 IP、agent 要借這台的對外 IP 時才連:`ssh -N company-ec2-socks`,用完 Ctrl-C 關掉。
# RemoteForward 只寫 port、不寫目的地 = 反向 SOCKS:EC2 的 127.0.0.1:1080 進來的連線由這台的 ssh 代連出去,
# EC2 上的 headless Chrome 帶 proxy 指到 1080(agent-config 的 personal-pc-tunnel skill)。不放進一般的
# company-ec2:平常 agent 的流量不該經過這台,EC2 的 1080 也只有一個位子。位子被占著就直接失敗。
Host company-ec2-socks
    HostName 100.98.146.109
    User ubuntu
    IdentityFile ~/.ssh/company-henry.pem
    IdentitiesOnly yes
    RemoteForward 127.0.0.1:1080
    ExitOnForwardFailure yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
{{- if includeTemplate "tailscale-userspace" . }}
    ProxyCommand {{ .chezmoi.homeDir }}/.local/bin/tailscale --socket={{ .chezmoi.homeDir }}/.local/state/tailscale/tailscaled.sock nc %h %p
{{- end }}

# 備用:EC2 的 tailscale 掛掉時走公網 IP。
Host company-ec2-public
    HostName 18.141.90.104
    User ubuntu
    IdentityFile ~/.ssh/company-henry.pem
    IdentitiesOnly yes
