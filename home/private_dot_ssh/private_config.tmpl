# 不寫 IdentityFile:ssh 用預設的 ~/.ssh/id_ed25519。Host 寫了 IdentityFile,ssh 就不找預設檔。

# ===============================================================
# 1. GitHub
# ===============================================================
Host github.com
    HostName github.com
    User git

# ===============================================================
# 2. Tailscale 節點 (Tailscale devices)
# ===============================================================
# HostName 寫 MagicDNS 的完整名稱(<裝置名>.<tailnet>.ts.net),新增主機也要加進第 6 節。
#   不寫短名:短名只有同一個 tailnet 的機器解析得到。公司 tailnet(tail29dcee)的機器分享給
#     個人 tailnet 的 laptop 之後,laptop 上 lianghua 解析失敗、pos2-dev 解析到區網的同名機器(#307)。
#   不寫 IP:機器重新註冊 tailscale 就換 IP,名稱不變。
# henry-laptop 在個人 tailnet,只有個人 tailnet 的機器連得到,所以留短名;
# 公司那邊連不到,要用時由 laptop 開 ssh -R。
# Windows 端要跑 OpenSSH server,admin 金鑰必須放在
#   C:\ProgramData\ssh\administrators_authorized_keys
Host henry-laptop
    HostName henry-laptop
    User henry

# 平常用的那台桌機,tailnet 裝置名 desktop-ifmbqh5
Host henry-desktop
    HostName desktop-ifmbqh5.tail29dcee.ts.net
    User henry

# 量華的 Windows(DESKTOP-4P510DU),本機帳號 user
Host lianghua
    HostName lianghua.tail29dcee.ts.net
    User user

Host pos2-dev
    HostName pos2-dev.tail29dcee.ts.net
    User user

# ===============================================================
# 3. Oracle VPS — tenancy A (我的)
# ===============================================================
# 這節和第 4 節是兩個不同的 Oracle 帳號(tenancy),各自有一份獨立的 Always Free
# 額度,分開算。Host 名不一定等於 OCI Console 上的 display name,每台在自己那段
# 註解標出 Console 上叫什麼,免得再搞混。
# 判斷某台屬於哪個帳號,登進去跑:
#   curl -sH "Authorization: Bearer Oracle" \
#     http://169.254.169.254/opc/v2/instance/ | jq -r .compartmentId
#   tenancy A = ...z3lry3...   tenancy B = ...7yh5zf...
#
# A1 額度(2 OCPU / 12 GB)全開給下面這一台。E2.1.Micro 額度(上限 2 台)是空的。

# Console display name:a1-2c12g。A1 Flex,2 OCPU / 12 GB,AD-2 / FD-1。
# 跑著 keepalive(~/bin/oci-keepalive.sh,crontab @reboot 起)防閒置回收,
# oracle-toolkit 的預設週期 3s/7s,實測整機 31% CPU(判定門檻是 20%)。
Host henry-a1
    HostName 129.80.13.225
    User ubuntu

# ===============================================================
# 4. Oracle VPS — tenancy B (別人的,不要動)
# ===============================================================
# 兩台 A1 各 1 OCPU / 6 GB,把 B 的 A1 額度佔滿了(2/2 OCPU、12/12 GB)。

# a1-fleet-1,跑 hermes gateway + ollama + nginx
Host hermes
    HostName 150.136.179.96
    User henry
    IdentitiesOnly yes

# a1-fleet-2,跑 openab-codex / openab-patrick / openab-claude 三個 container
# User 是 ubuntu 不是 henry,原本寫 henry 一直 Permission denied
Host openab
    HostName 158.101.108.0
    User ubuntu
    IdentitiesOnly yes

# 另一個拿掉的舊 Host:oracle-2 = 129.159.185.160。它也在 tenancy B,是
# 2026-07-20 前的舊 hermes micro(instance-20260709-1122),不是我的,別終止它。

# ===============================================================
# 5. 公司 AWS EC2
# ===============================================================
# 走 tailnet。不帶任何轉發:遠端的 port 只有一個位子,每條連線都帶的話先連的搶到、其他默默失敗
# (以前 9222 轉發就是這樣)。要轉發就在要用時另打一條 ssh -N -o ExitOnForwardFailure=yes -L/-R …,
# 指令見 docs/remote-access/README.md;以前的 company-ec2-attach／-socks／-chrome 別名拿掉了(#278)。
# company-henry.pem 是公司發的;沒有它的機器用自己的 id_ed25519(ssh 會跳過不存在的檔)。
Host company-ec2
    HostName aws-ec2-henry.tail29dcee.ts.net
    User ubuntu
    IdentityFile ~/.ssh/company-henry.pem
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# 備用:EC2 的 tailscale 掛掉時走公網 IP。
Host company-ec2-public
    HostName 18.141.90.104
    User ubuntu
    IdentityFile ~/.ssh/company-henry.pem
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
{{- if includeTemplate "tailscale-userspace" . }}

# ===============================================================
# 6. 沒有 root:tailnet 主機經 userspace tailscale
# ===============================================================
# userspace tailscale 沒有網卡,連線和解析都經 tailscaled(見 .chezmoitemplates/tailscale-userspace)。
Host henry-laptop henry-desktop lianghua pos2-dev company-ec2
    ProxyCommand {{ .chezmoi.homeDir }}/.local/bin/tailscale --socket={{ .chezmoi.homeDir }}/.local/state/tailscale/tailscaled.sock nc %h %p
{{- end }}
