# 只在這台臨時用的 Host 寫 ~/.ssh/config.local(不進 git);沒有這個檔也不報錯。
# 要放最上面:寫在某個 Host 段底下的話,只有連那台時才讀得到。
Include ~/.ssh/config.local

# 不寫 IdentityFile:ssh 用預設的 ~/.ssh/id_ed25519。Host 寫了 IdentityFile,ssh 就不找預設檔。

# ===============================================================
# 1. GitHub
# ===============================================================
Host github.com
    HostName github.com
    User git

# ===============================================================
# 2. Tailscale:個人 tailnet(tail0fed08)
# ===============================================================
# HostName 寫 MagicDNS 完整名稱(<裝置名>.<tailnet>.ts.net):短名只有同一個 tailnet 解析得到(#307),
# IP 重新註冊就換。新增主機也要加進第 6 節。
# 例外:henry-laptop 的 HostName 是短名,只有同在這個 tailnet(tail0fed08)的機器解析得到。
Host henry-laptop
    HostName henry-laptop
    User henry

# 公司 tailnet 的 desktop-ifmbqh5 是另一台,不是它
Host henry-desktop
    HostName henry-desktop.tail0fed08.ts.net
    User henry

# 公司的機器,在個人 tailnet。Host 不帶轉發:每條連線都帶的話第二條搶不到 port,
# 要轉發另打一條,見 docs/how-to/remote-access/README.md。
# company-henry.pem 是公司發的;沒有它的機器用 id_ed25519(ssh 會跳過不存在的檔)。
Host company-ec2
    HostName company-ec2.tail0fed08.ts.net
    User ubuntu
    IdentityFile ~/.ssh/company-henry.pem
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# ===============================================================
# 3. Tailscale:公司 tailnet(tail29dcee)分享進來的
# ===============================================================
# 公司收回分享,這節全部連不到。
Host lianghua
    HostName lianghua.tail29dcee.ts.net
    User user

Host pos2-dev
    HostName pos2-dev.tail29dcee.ts.net
    User user

# ===============================================================
# 4. 跳板後面的機器
# ===============================================================
# 量華的 Hyper-V 測試機。IP 在 Default Switch 上,VM 重開機可能會變:連不到先到 lianghua 查 IP
# (Get-VM 列出每台的 IP)。vm-2 是從 vm-1 複製的,帳號同樣是 user-1。
Host vm-1
    HostName 172.22.123.179
    User user-1
    ProxyJump lianghua

Host vm-2
    HostName 172.22.119.172
    User user-1
    ProxyJump lianghua

# 個人電腦的 WSL:經那台 Windows 跳到它的 127.0.0.1:2222(WSL 的 sshd 只聽 127.0.0.1:2222,避開 Windows 的 22)。
# 都叫 127.0.0.1,所以每台用 HostKeyAlias 分開記 host key。
Host henry-desktop-wsl
    ProxyJump henry-desktop
    HostKeyAlias henry-desktop-wsl

Host henry-laptop-wsl
    ProxyJump henry-laptop
    HostKeyAlias henry-laptop-wsl

# Port 跟 WSL 那台 sshd 聽的同一個值(.chezmoidata/openssh-server.yaml)。
# 不寫 localhost:Windows 的 localhost 先解析成 ::1,WSL 的 mirrored 網路模式不支援 ::1,連過去會被直接關掉
Host *-wsl
    HostName 127.0.0.1
    Port {{ .opensshServer.wslPort }}
    User henry

# ===============================================================
# 5. 公網
# ===============================================================
# Oracle 有兩個帳號(tenancy),Always Free 額度各算各的;判斷某台屬於哪個帳號見 docs/how-to/oracle-vps.md。

# 我的(tenancy A)。Console 上叫 a1-2c12g。跑著 keepalive(~/bin/oci-keepalive.sh)防閒置回收,別停
Host henry-a1
    HostName 129.80.13.225
    User ubuntu

# 別人的(tenancy B),不要動,見 docs/how-to/oracle-vps.md。a1-fleet-1:hermes gateway、ollama、nginx
Host hermes
    HostName 150.136.179.96
    User henry
    IdentitiesOnly yes

# 別人的(tenancy B),不要動。a1-fleet-2:openab 的三個 container
Host openab
    HostName 158.101.108.0
    User ubuntu
    IdentitiesOnly yes

# company-ec2 的備用:tailscale 掛掉時走公網 IP。
Host company-ec2-public
    HostName 18.141.90.104
    User ubuntu
    IdentityFile ~/.ssh/company-henry.pem
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
{{- if includeTemplate "tailscale-userspace" . }}

# ===============================================================
# 6. 沒有 root:tailnet 主機經 userspace tailscale
# ===============================================================
# userspace tailscale 沒有網卡,連線和解析都經 tailscaled(見 .chezmoitemplates/tailscale-userspace)。
# 跳板後面的機器不用列:跳板那一段已經經過這裡,它們自己是跳板上的 localhost 或區網 IP。
Host henry-laptop henry-desktop lianghua pos2-dev company-ec2
    ProxyCommand {{ .chezmoi.homeDir }}/.local/bin/tailscale --socket={{ .chezmoi.homeDir }}/.local/state/tailscale/tailscaled.sock nc %h %p
{{- end }}
