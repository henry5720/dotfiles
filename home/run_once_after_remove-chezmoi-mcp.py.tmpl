#!/usr/bin/env python3
# 一次性遷移:MCP 從 chezmoi 交給 skillshare(dotfiles #34)。
#
# 舊版 chezmoi 在三個 client 設定裡寫了 MCP 條目。skillshare 看到同名、不是它寫的條目
# 會整批停下(existing entry is not managed),所以這支把舊條目拿掉,讓
# `skillshare sync mcp -g` 可以直接寫。
#
# 只刪「跟舊版 chezmoi 寫的一字不差」的條目:skillshare 寫的(版本釘死、key 走 fromEnv)
# 和手動加或改過的都不碰。手動加的要自己 import 或刪,見 docs/ai-agent-setup.md 的 MCP 那節。
#
# run_once 每台機器只跑一次;新機器上沒有舊條目,跑了什麼都不做。
# 所有機器都遷移完(#37)就可以刪掉這支。
import json
import os
import re
import tomllib

dest = {{ .chezmoi.destDir | quote }}


def write(path, text):
    # 先寫暫存檔再換名:Claude Code 可能正在寫 ~/.claude.json,中途斷掉也不會留下半個檔。
    tmp = path + ".chezmoi-tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, os.stat(path).st_mode & 0o777)
    os.replace(tmp, path)

CHROME_ARGS = [
    "-y",
    "chrome-devtools-mcp@latest",
    "--browser-url=http://127.0.0.1:9222",
    "--no-usage-statistics",
    "--no-performance-crux",
]
CODEGRAPH_ARGS = ["serve", "--mcp"]


def is_legacy_codex(name, table):
    if name == "chrome-devtools":
        return table == {"command": "npx", "args": CHROME_ARGS, "enabled": True, "startup_timeout_sec": 60}
    if name == "codegraph":
        return table == {"command": "codegraph", "args": CODEGRAPH_ARGS, "enabled": True}
    if name == "context7":
        # key 是本機的值,只看形狀。
        base = {k: v for k, v in table.items() if k != "http_headers"}
        headers = table.get("http_headers", {})
        return base == {"url": "https://mcp.context7.com/mcp", "enabled": True} and set(headers) <= {"CONTEXT7_API_KEY"}
    return False


LEGACY_JSON = {
    ".claude.json": ("mcpServers", {
        "chrome-devtools": {"type": "stdio", "command": "npx", "args": CHROME_ARGS, "env": {}},
    }),
    ".config/opencode/opencode.json": ("mcp", {
        "chrome-devtools": {"enabled": True, "type": "local", "command": ["npx"] + CHROME_ARGS},
        "codegraph": {"enabled": True, "type": "local", "command": ["codegraph"] + CODEGRAPH_ARGS},
    }),
}


def clean_json(rel, section, legacy):
    path = os.path.join(dest, rel)
    if not os.path.exists(path):
        return
    text = open(path, encoding="utf-8").read()
    data = json.loads(text)
    servers = data.get(section, {})
    removed = [name for name, value in legacy.items() if servers.get(name) == value]
    if not removed:
        return
    for name in removed:
        del servers[name]
    out = json.dumps(data, indent=2, ensure_ascii=False)
    # 保留原本結尾有沒有換行(Claude Code 寫的 ~/.claude.json 沒有)。
    if text.endswith("\n"):
        out += "\n"
    write(path, out)
    print(f"{rel}: 移除舊的 chezmoi MCP 條目 {', '.join(removed)}")


def clean_codex():
    path = os.path.join(dest, ".codex/config.toml")
    if not os.path.exists(path):
        return
    text = open(path, encoding="utf-8").read()
    servers = tomllib.loads(text).get("mcp_servers", {})
    removed = [name for name, table in servers.items() if is_legacy_codex(name, table)]
    if not removed:
        return
    # 舊版寫的是一般的 [mcp_servers.NAME] table(沒有子 table),刪到下一個 table 或
    # 註解為止 —— 後面緊接的註解是下一段的橫幅(例如停用 skill 那段),不能一起刪。
    header = re.compile(r"^\s*\[\[?\s*([^\]]+?)\s*\]\]?\s*(#.*)?$")
    out, dropping = [], False
    for line in text.splitlines(keepends=True):
        match = header.match(line)
        if match:
            dropping = match.group(1) in {f"mcp_servers.{name}" for name in removed}
        elif dropping and line.lstrip().startswith("#"):
            dropping = False
            # 橫幅前面那個空行跟著被刪的 table 走了,補回來(codex 的 modify_ 也會這樣排)。
            if out and out[-1].strip():
                out.append("\n")
        if not dropping:
            out.append(line)
    result = "".join(out).rstrip("\n") + "\n"
    # 文字比對只認得不加引號的 header;沒刪到的(例如 [mcp_servers."x"])就不算。
    left = tomllib.loads(result).get("mcp_servers", {})
    removed = [name for name in removed if name not in left]
    if not removed:
        return
    write(path, result)
    print(f".codex/config.toml: 移除舊的 chezmoi MCP 條目 {', '.join(removed)}")


for rel, (section, legacy) in LEGACY_JSON.items():
    clean_json(rel, section, legacy)
clean_codex()
