{{- if has "claude" (index . "tools") -}}
#!{{ lookPath "sh" }}
# 選裝工具 Claude Code(選單見 .chezmoi.toml.tmpl)。沒勾就渲染成空的,chezmoi 不跑。
# 官方 native installer,裝到 ~/.local/bin/claude,之後自己會更新。
set -eu

# 1. 已經有就不重裝。chezmoi 跑腳本時的 PATH 不一定有 ~/.local/bin,所以也直接看檔案
if command -v claude >/dev/null 2>&1 || [ -x "$HOME/.local/bin/claude" ]; then
  echo "Claude Code 已安裝,跳過"
  exit 0
fi

# 2. 安裝
curl -fsSL https://claude.ai/install.sh | bash
{{ end -}}
