{{- if has "ttyd" (index . "tools") -}}
#!{{ lookPath "sh" }}
# 選裝工具 ttyd(選單見 .chezmoi.toml.tmpl)。沒勾就渲染成空的,chezmoi 不跑。
# 把 terminal 開成網頁,臨時給沒有 tailscale／ssh key 的人用。
# 怎麼開、怎麼收見 docs/share-with-guest.md(用 share-shell)。
# 抓 GitHub release 的單一執行檔,chezmoi 不負責更新它。
set -eu

if command -v ttyd >/dev/null 2>&1; then
  echo "ttyd 已安裝,跳過"
  exit 0
fi
arch=$(uname -m)
case "$arch" in
  x86_64|aarch64) ;;
  *) echo "ttyd 不支援架構 $arch,跳過"; exit 0 ;;
esac
mkdir -p "$HOME/.local/bin"
curl -fsSL -o "$HOME/.local/bin/ttyd" "https://github.com/tsl0922/ttyd/releases/latest/download/ttyd.$arch"
chmod +x "$HOME/.local/bin/ttyd"
{{ end -}}
