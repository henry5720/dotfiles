{{- $personal := default dict (index . "aiPersonal") -}}
#!{{ lookPath "sh" }}
# shebang 用 lookPath:Termux 沒有 /bin/sh,而 chezmoi 是 Go、繞過 termux-exec,寫死 /bin/sh 會 fork/exec 失敗。
# 共用 ~/.codex 的 personal profile；只管理 model/provider/login，不碰 base gateway、credential 或 state。
set -eu
python3 -c '
import json
import sys
import tomllib

existing = sys.stdin.read()
try:
    value = tomllib.loads(existing) if existing.strip() else {}
except tomllib.TOMLDecodeError as error:
    raise SystemExit("personal Codex config 不是合法 TOML: " + str(error))
model = {{ with (default "" (index $personal "codexModel")) }}{{ . | quote }}{{ else }}""{{ end }}
lines = []
table = ()
for line in existing.splitlines():
    stripped = line.strip()
    if stripped.startswith("["):
        table = tuple(stripped.strip("[]").split("."))
    # 權限 key 也丟掉:用 --profile personal 時,TUI 的 /permissions 會寫進這份,蓋過 base 的 auto_review(#204)。
    if not table and any(stripped.startswith(key + " ") or stripped.startswith(key + "=") for key in ("model", "model_provider", "forced_login_method", "approval_policy", "sandbox_mode", "approvals_reviewer")):
        continue
    lines.append(line)
candidate = []
if model:
    candidate.append("model = " + json.dumps(model))
candidate += ["model_provider = \"openai\"", "forced_login_method = \"chatgpt\""]
candidate += lines
text = "\n".join(candidate).rstrip() + "\n"
try:
    tomllib.loads(text)
except tomllib.TOMLDecodeError as error:
    raise SystemExit("personal Codex candidate 不是合法 TOML: " + str(error))
sys.stdout.write(text)
'
