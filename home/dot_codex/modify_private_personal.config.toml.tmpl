{{- $personal := default dict (index . "aiPersonal") -}}
#!/bin/sh
# 共用 ~/.codex 的 personal profile；只管理 model/provider/login 與個人 skill deny，不碰 base gateway、credential 或 state。
set -eu
python3 -c '
import json
import sys
import tomllib

existing = sys.stdin.read()
try:
    value = tomllib.loads(existing) if existing.strip() else {}
except tomllib.TOMLDecodeError as error:
    raise SystemExit("personal Codex config 不是合法 TOML: " + str(error))
model = {{ with (default "" (index $personal "codexModel")) }}{{ . | quote }}{{ else }}""{{ end }}
# skillshare 放在 ~/.agents/skills;舊位置 ~/.codex/skills 那份由 .chezmoiremove 刪掉。
skill_paths = [{{ printf "%s/.agents/skills/company-imagegen-fallback/SKILL.md" .chezmoi.homeDir | quote }}]
lines = []
table = ()
for line in existing.splitlines():
    stripped = line.strip()
    if stripped.startswith("["):
        table = tuple(stripped.strip("[]").split("."))
    if not table and any(stripped.startswith(key + " ") or stripped.startswith(key + "=") for key in ("model", "model_provider", "forced_login_method")):
        continue
    lines.append(line)
skill_header = "[[skills.config]]"
for skill_path in skill_paths:
    skill_blocks = []
    start = None
    for index, line in enumerate(lines + [skill_header]):
        if line.strip() == skill_header:
            if start is not None:
                skill_blocks.append((start, index))
            start = index
    for start, end in reversed(skill_blocks):
        block = lines[start:end]
        if any(line.strip() == "path = " + json.dumps(skill_path) for line in block):
            enabled = next((index for index, line in enumerate(block) if line.strip().startswith("enabled") and "=" in line), None)
            if enabled is None:
                path_index = next(index for index, line in enumerate(block) if line.strip().startswith("path") and "=" in line)
                lines.insert(start + path_index + 1, "enabled = false")
            else:
                lines[start + enabled] = "enabled = false"
            break
    else:
        if lines and lines[-1].strip():
            lines.append("")
        lines += [skill_header, "path = " + json.dumps(skill_path), "enabled = false"]
candidate = []
if model:
    candidate.append("model = " + json.dumps(model))
candidate += ["model_provider = \"openai\"", "forced_login_method = \"chatgpt\""]
candidate += lines
text = "\n".join(candidate).rstrip() + "\n"
try:
    tomllib.loads(text)
except tomllib.TOMLDecodeError as error:
    raise SystemExit("personal Codex candidate 不是合法 TOML: " + str(error))
sys.stdout.write(text)
'
