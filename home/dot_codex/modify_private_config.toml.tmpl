#!/bin/sh
# ~/.codex/config.toml 是兩方共用的檔案:上半段是這個 repo 的設定,下半段全是 codex
# 自己寫進去的狀態(信任過的專案、TUI 提示計數器、feature flag、hook 的 trusted_hash)。
# 整份納管的話每跑一次 codex 就多一段 diff,而且那些絕對路徑等於把專案清單推上公開 repo。
#
# 所以用 chezmoi 的 modify_:現有檔案從 stdin 進來,只管理 provider 與三個 MCP server;
# codex 自己的 table 原封不動吐回去。`chezmoi diff` 因此會是空的。
# 同一招的前例見 home/modify_private_dot_claude.json。
#
# ⚠️ codex 會把 key 寫在第一個 table 之前的頂層(例如 approvals_reviewer)。那些 key 只能
# 留在頂層區:一旦排到 [model_providers.codex-lb-gcp] 後面,TOML 就會把它當成那個 table
# 的欄位,語意整個改掉。所以下面把它們獨立收進 $preamble_file,插在 model_reasoning_effort
# 與第一個 table 之間。留不住或放錯位置,尾端的安全檢查都會擋下來(comparable() 比的是
# 解析後的結構,位置變了就是結構變了)。
#
# ⚠️ 新機器上這份只會產出 repo provider 與 MCP 設定,下半段要自己長回來:
#   - 信任專案:第一次進那個目錄時 codex 會問,答 yes 就寫回檔案
#   - [features] hooks = true + ~/.codex/hooks.json + herdr-agent-state.sh
#     這三樣是 herdr 裝的(那支腳本檔頭就寫 "managed by herdr"),重跑 herdr
#     的 codex 整合會一起回來。不要在這裡 enable,沒有 hooks.json 等於沒開。
set -eu
existing=$(cat)

input_file=$(mktemp)
trap 'rm -f "$input_file"' EXIT HUP INT TERM
printf '%s' "$existing" > "$input_file"
output_file=$(mktemp)
context7_file=$(mktemp)
preamble_file=$(mktemp)
trap 'rm -f "$input_file" "$output_file" "$context7_file" "$preamble_file"' EXIT HUP INT TERM
cat > "$context7_file" <<'CONTEXT7'
{{- with (index . "context7ApiKey") }}
[mcp_servers.context7]
http_headers = { "CONTEXT7_API_KEY" = {{ . | quote }} }
{{- end }}
CONTEXT7
python3 -c '
import json
import sys
import tomllib

managed = {"chrome-devtools", "codegraph", "context7"}
managed_top_keys = ("model", "model_provider", "model_reasoning_effort")
provider = "codex-lb-gcp"
markers = {"# 由 chezmoi 管理的 MCP servers。", "# MCP servers managed by chezmoi."}
out = []
preamble = []
keep = False
seen_table = False

def header_path(line):
    if not line.lstrip().startswith("["):
        return None
    try:
        parsed = tomllib.loads(line + "\n__codex_header_sentinel = true\n")
    except tomllib.TOMLDecodeError:
        return None
    def find(value, path=()):
        if isinstance(value, dict):
            for key, child in value.items():
                if key == "__codex_header_sentinel" and child is True:
                    return path
                found = find(child, path + (key,))
                if found is not None:
                    return found
        elif isinstance(value, list):
            for child in value:
                found = find(child, path)
                if found is not None:
                    return found
        return None
    return find(parsed)

def comparable(text):
    value = tomllib.loads(text)
    for key in ("model", "model_provider", "model_reasoning_effort"):
        value.pop(key, None)
    providers = value.get("model_providers", {})
    providers.pop(provider, None)
    if not providers:
        value.pop("model_providers", None)
    servers = value.get("mcp_servers", {})
    for name in managed:
        servers.pop(name, None)
    if not servers:
        value.pop("mcp_servers", None)
    return value

existing = sys.stdin.read()
for line in existing.splitlines(keepends=True):
    if line.rstrip("\n") in markers:
        while out and (not out[-1].strip() or out[-1].startswith("# ===")):
            out.pop()
        keep = False
        continue
    path = header_path(line.rstrip("\n"))
    if path is not None:
        seen_table = True
        table = ".".join(path)
        if table == "model_providers." + provider or table.startswith("model_providers." + provider + "."):
            keep = False
            continue
        if table == "mcp_servers." + path[-1] and path[0] == "mcp_servers" and path[-1] in managed:
            keep = False
            continue
        if path[0] == "mcp_servers" and len(path) > 1 and path[1] in managed:
            keep = False
            continue
        keep = True
    if not seen_table:
        # 頂層區。註解與空行是這個樣板自己產生的,會重新長出來;managed_top_keys 也是。
        # 其餘(codex 自己寫的頂層 key)原樣留著。
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if any(stripped.startswith(key) and stripped[len(key):].lstrip().startswith("=") for key in managed_top_keys):
            continue
        preamble.append(line)
        continue
    if keep:
        out.append(line)
while out and not out[-1].strip():
    out.pop()
preamble_text = "".join(preamble).strip("\n")
open(sys.argv[2], "w", encoding="utf-8").write(preamble_text + "\n" if preamble_text else "")
candidate = "".join(out).rstrip("\n")
if candidate:
    candidate += "\n\n"
candidate += """# ============================================================
# 由 chezmoi 管理的 MCP servers。
# ============================================================

[mcp_servers.chrome-devtools]
command = "npx"
args = ["-y", "chrome-devtools-mcp@latest", "--browser-url=http://127.0.0.1:9222", "--no-usage-statistics", "--no-performance-crux"]
enabled = true
startup_timeout_sec = 60

[mcp_servers.codegraph]
command = "codegraph"
args = ["serve", "--mcp"]
enabled = true

[mcp_servers.context7]
url = "https://mcp.context7.com/mcp"
enabled = true
"""
context7_text = open(sys.argv[1], encoding="utf-8").read()
if context7_text.strip():
    context7_data = tomllib.loads(context7_text)
    headers = context7_data["mcp_servers"]["context7"]["http_headers"]
    candidate += "http_headers = { \"CONTEXT7_API_KEY\" = " + json.dumps(headers["CONTEXT7_API_KEY"], ensure_ascii=False) + " }\n"
# 檢查要比的是完整的最終檔(頂層 key 在前、table 在後),不是 stdout 這半段。
verified = preamble_text + "\n\n" + candidate if preamble_text else candidate
try:
    before, after = comparable(existing), comparable(verified)
    if before != after:
        changed = sorted(set(before) | set(after))
        changed = [key for key in changed if before.get(key) != after.get(key)]
        raise ValueError("非 managed TOML 設定在重寫後改變: " + ",".join(changed))
    tomllib.loads(verified)
except (tomllib.TOMLDecodeError, ValueError) as error:
    raise SystemExit("codex config 安全更新失敗: " + str(error))
sys.stdout.write(candidate)
' "$context7_file" "$preamble_file" < "$input_file" > "$output_file"
cat <<'TOML'
# ============================================================
# codex-lb - 公司自架的 codex 負載平衡器 (GCP asia-east1-b)；以下 provider 與三個 MCP
# server 是 repo 管理的區塊，其餘 codex 狀態由下方腳本保留。
# ============================================================
model = "gpt-6-astra"
model_provider = "codex-lb-gcp"
model_reasoning_effort = "medium"
TOML
cat "$preamble_file"
cat <<'TOML'

[model_providers.codex-lb-gcp]
name = "openai"
base_url = "https://codex.teamsync.com.tw/backend-api/codex"
wire_api = "responses"
experimental_bearer_token = "{{ .codexLbApiKey }}"
supports_websockets = true
request_max_retries = 4
stream_max_retries = 10
stream_idle_timeout_ms = 300000
TOML
cat "$output_file"
