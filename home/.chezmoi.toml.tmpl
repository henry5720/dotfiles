{{- /* 以 root 執行、$HOME 又不屬於 root 時,init 一開頭就停(見 .chezmoitemplates/home-owner-guard)。 */ -}}
{{- includeTemplate "home-owner-guard" . -}}
{{- /* 用途與選裝工具:先問這台的用途(完整／精簡／自訂),再出選裝工具選單,照用途的預設組合勾好,可以再調。
       用途在 config 與提示上是英文代號 full／minimal／custom:chezmoi 的 promptChoice 是打字的輸入框、不是清單,
       中文選項得切輸入法;代號打開頭一個字母就夠(f、m、c),Enter 用預設。
       只在 Linux(Ubuntu、WSL、proot Ubuntu,與非 Debian 系;後者的選裝工具走 mise,見 .chezmoitemplates/use-mise)
       與 macOS 問。原生 Termux 不問,自動套用精簡,濾掉 tailscale、btop。
       選單每台列 tool-menu 的全部工具;這台不建議、裝不了的(.chezmoitemplates/tool-env)標原因、預設組合不勾,
       裝不了的勾了 apply 時略過,最後由略過彙整列出原因。
       Windows 什麼都不問:沒有用途、選單、憑證與 git 身分,tools = [];要改 Windows 部署什麼就改 repo
       (白名單在 .chezmoiignore 的 Windows 段)。
       存法:選單結果等於這台的預設組合(已扣掉不建議與裝不了的)時存用途,之後預設組合改了,跑 `chezmoi init` 就跟上;
       有改就存自訂(custom),tools 照勾的存、不再跟著預設組合走。
       不管存哪種,[data] 都寫展開後的 tools:其他樣板一律看 .tools,不認得用途。
       之後要改:打 `tools`(home/dot_local/bin/executable_tools.tmpl)重出兩個問題,預設帶現在的用途與勾選,
       勾完直接 apply。新勾的會裝,取消勾選、改用途都不會解除安裝。
       選項與說明在 .chezmoitemplates/tool-menu。加一個新工具要動四處:
         1. tool-menu 加一行「工具名 說明」(完整 = 選單上全部,自動算進去)。
            哪個環境不建議或裝不了:在 tool-env 加規則與原因(選單標註、預設組合、略過彙整都從那裡拿)。
         2. 要不要放進精簡:改下面的 $lean。
         3. 照 #231 的順序挑裝法,填進 .chezmoidata/packages.yaml(macOS 一律走 brew,填 toolPackages.darwin,app 寫成 casks;
            Termux 走 pkg,填 toolPackages.termux):
            - GitHub release 的單一執行檔(mise registry 是 aqua／github backend):只填 miseTools,加 always: true。
            - 要系統函式庫的(mise 只有 conda backend):填 toolPackages.ubuntu,miseTools 再列一次
              (apt 用不了的 Linux 改用 mise 裝,見 .chezmoitemplates/use-mise)。
            - 有官方 installer 或官方 apt 源、會自己更新的:寫一支
            .chezmoiscripts/run_onchange_after_install-<工具>.sh.tmpl,整段包在
            {{ if has "<工具>" (splitList " " (includeTemplate "tools-to-install" .)) }} 裡
            (不直接看 .tools:這台裝不了的勾了也不跑),已經裝了就跳過
            (用 npm 裝的例外,叫 npm-install-<工具>,見 npm-install-codegraph 開頭)。
            要 root 的步驟(apt、sudo)包在 {{ if includeTemplate "has-root" . }} 裡;沒有 root 時
            用 sh-skip 的 skip_root 印「略過＋手動方式」、exit 0(見 install-gh)。
         4. 存自訂的機器不會自己勾上,打 `tools` 勾它才會裝;存完整的跑 `chezmoi init` 就會帶進來。 */ -}}
{{- /* 以前在基底、拆成選裝工具的六項。舊 config(沒有 toolsSchema)升級時自動算進已勾,
       原本裝的東西不會少;寫回 config 時帶最新的 toolsSchema,之後就照存的勾選。
       toolsSchema 是 tools 的格式版本:沒有這個 key = 第 1 版(這六項還在基底、不在 tools 裡),
       2 = 這六項也要在 tools 裡勾才裝,
       3 = 提示列從 zsh 拆出來成為 starship(#194):第 2 版以前勾了 zsh 的(以前 zsh 附帶 p10k)自動補勾 starship。
       key 名與值已經寫在各台的 config,不要改;格式再變就加到 4。 */ -}}
{{- $baseSplit := list "zsh" "eza" "fzf" "bat" "ripgrep" "vim" -}}
{{- /* 精簡的預設組合:只放 shell 體驗(每台開 shell 看到的一樣,連 fastfetch 都有)。連線、監控(tailscale、btop)
       在完整或自己勾(#273)。完整 = 選單上全部;自訂 = 不預勾。
       用途的提示文字會出現在 Runbook 免回答安裝那一行(--promptChoice 的 key),改了要一起改
       (還有 docs/machine-use.md、script/tests/e2e.sh 的 USE_PROMPT);
       不能有半形逗號和 =(chezmoi 拿它們切 --promptChoice 的值)。 */ -}}
{{- $lean := list "zsh" "starship" "eza" "fzf" "bat" "ripgrep" "vim" "fastfetch" -}}
{{- $usePrompt := "用途：按一個字母（full 完整／minimal 精簡：只要 shell 體驗／custom 自訂）" -}}
{{- /* chezmoi 的 promptChoice 輸入對到唯一選項就送出、不等 Enter,灰字是選項值本身:
       選項值用字母,灰字就顯示要按的 f/m/c;存進 config 的還是 full／minimal／custom。 */ -}}
{{- $useChoices := list "f" "m" "c" -}}
{{- $useLetter := dict "full" "f" "minimal" "m" "custom" "c" -}}
{{- $letterUse := dict "f" "full" "m" "minimal" "c" "custom" -}}
{{- /* #222 以前 config 存的是中文,init 時換成代號,勾選不變。 */ -}}
{{- $legacyUse := dict "完整" "full" "精簡" "minimal" "自訂" "custom" -}}
{{- $use := "minimal" -}}
{{- $tools := list -}}
{{- $windows := eq .chezmoi.os "windows" -}}
{{- if $windows -}}
{{- /* Windows:tools 留空。選裝工具全是 sh 腳本與 Linux／Termux 的套件,Windows 用 winget 手動裝(Runbook)。 */ -}}
{{- else if eq .chezmoi.os "android" -}}
{{- /* 不出選單的機器:原生 Termux 沒有 tailscale、btop 的套件腳本。濾完剩下的就是 $baseSplit。 */ -}}
{{-   range $lean -}}
{{-     if not (has . (list "tailscale" "btop")) }}{{ $tools = append $tools . }}{{ end -}}
{{-   end -}}
{{- else -}}
{{- /* 選單每台列 tool-menu 的全部工具;這台不建議、裝不了的(.chezmoitemplates/tool-env)在說明後面標原因,
       預設組合不勾它們,勾了照存(裝不了的 apply 時略過、最後列出原因)。
       $labels 記工具名 → 選單文字(排版在 tool-menu-labels)。
       $full 是完整的預設組合:選單上全部,扣掉這台不建議與裝不了的;精簡也扣掉它們。 */ -}}
{{-   $status := includeTemplate "tool-status" . | fromJson -}}
{{-   $toolChoices := list -}}
{{-   $labels := dict -}}
{{-   $full := list -}}
{{-   range splitList "\n" (includeTemplate "tool-menu-labels" .) -}}
{{-     $name := index (splitList " " .) 0 -}}
{{-     if $name -}}
{{-       $_ := set $labels $name . -}}
{{-       $toolChoices = append $toolChoices . -}}
{{-       if not (hasKey $status $name) }}{{ $full = append $full $name }}{{ end -}}
{{-     end -}}
{{-   end -}}
{{-   $presets := dict "full" $full "minimal" (list) "custom" (list) -}}
{{-   range $lean -}}
{{-     if has . $full }}{{ $_ := set $presets "minimal" (append (get $presets "minimal") .) }}{{ end -}}
{{-   end -}}
{{- /* 現在的用途與勾選(兩個問題的預設值從它算)。只有 tools、沒有用途的舊 config 算自訂。
       存完整、精簡的,勾選就是現在的預設組合,不看 config 裡那份展開過的 tools。 */ -}}
{{-   $storedUse := "" -}}
{{-   if hasKey . "machineUse" -}}
{{-     $storedUse = .machineUse -}}
{{-     if hasKey $legacyUse $storedUse }}{{ $storedUse = get $legacyUse $storedUse }}{{ end -}}
{{-   else if hasKey . "tools" -}}
{{-     $storedUse = "custom" -}}
{{-   end -}}
{{-   if not (hasKey $presets $storedUse) }}{{ $storedUse = "" }}{{ end -}}
{{- /* 自訂的勾選:舊 config 在這裡升級(沒有 toolsSchema 補上 $baseSplit,第 2 版以前有 zsh 補上 starship)。 */ -}}
{{-   $current := list -}}
{{-   if hasKey . "tools" -}}
{{-     $current = .tools -}}
{{-     if not (hasKey . "toolsSchema") -}}
{{-       range $baseSplit -}}
{{-         if not (has . $current) }}{{ $current = append $current . }}{{ end -}}
{{-       end -}}
{{-     end -}}
{{-     if and (lt (int (default 0 (index . "toolsSchema"))) 3) (has "zsh" $current) (not (has "starship" $current)) -}}
{{-       $current = append $current "starship" -}}
{{-     end -}}
{{-   end -}}
{{-   if and $storedUse (ne $storedUse "custom") -}}
{{-     $current = get $presets $storedUse -}}
{{-   end -}}
{{- /* 舊的 document-media 拆出來只剩 ffmpeg,舊機器的勾選照樣帶過去。
       nvm 改名 node(#209 拿掉、#222 放回選單),還存著 nvm 的換成 node。 */ -}}
{{-   if has "document-media" $current -}}
{{-     $current = append $current "ffmpeg" -}}
{{-   end -}}
{{-   if has "nvm" $current -}}
{{-     $renamed := list -}}
{{-     range $current }}{{ $renamed = append $renamed (ternary "node" . (eq . "nvm")) }}{{ end -}}
{{-     $current = $renamed -}}
{{-   end -}}
{{- /* 用途:存過就沿用(init --prompt 才重問,預設帶現在的);第一次預設精簡:直接 Enter 也有 zsh 與常用 CLI,不會裝出只有基底的機器。
       問的是字母、存的是代號:存過的用途換成字母當預設,選到的字母換回代號。 */ -}}
{{-   $useStored := dict -}}
{{-   if $storedUse }}{{ $_ := set $useStored "machineUse" (get $useLetter $storedUse) }}{{ end -}}
{{-   $use = get $letterUse (promptChoiceOnce $useStored "machineUse" $usePrompt $useChoices (get $useLetter (default "minimal" $storedUse))) -}}
{{- /* 選單預設值:用途沒變、或改成自訂,帶現在的勾選;改成完整或精簡,帶那個用途的預設組合。
       用途沒變時才把勾選當成「已經存過」:不加 --prompt 的 init 不出選單,遷移也照樣生效。 */ -}}
{{-   $defaultNames := $current -}}
{{-   if and (ne $use $storedUse) (ne $use "custom") -}}
{{-     $defaultNames = get $presets $use -}}
{{-   end -}}
{{-   $toolsStored := dict -}}
{{-   if and $storedUse (eq $use $storedUse) -}}
{{-     $_ := set $toolsStored "tools" $defaultNames -}}
{{-   end -}}
{{-   $toolDefaults := list -}}
{{-   range $defaultNames -}}
{{-     if and (hasKey $labels .) (not (has (get $labels .) $toolDefaults)) -}}
{{-       $toolDefaults = append $toolDefaults (get $labels .) -}}
{{-     end -}}
{{-   end -}}
{{- /* 選單回傳的是選單文字(已經存過時是存著的工具名),只留第一個空白前的工具名。
       拿掉的選項(mupdf-tools、pandoc 沒人用)舊機器可能還存著,濾掉;document-media 換成 ffmpeg、
       nvm 換成 node(見上面)。 */ -}}
{{-   $removed := list "mupdf-tools" "pandoc" "document-media" -}}
{{-   $picked := promptMultichoiceOnce $toolsStored "tools" "選裝工具（空白鍵勾選、Enter 確定；用途選錯按 Ctrl+C 重來）" $toolChoices $toolDefaults -}}
{{-   if has "document-media" $picked -}}
{{-     $picked = append $picked "ffmpeg" -}}
{{-   end -}}
{{-   range $picked -}}
{{-     $name := index (splitList " " .) 0 -}}
{{-     if not (or (has $name $removed) (has $name $tools)) -}}
{{-       $tools = append $tools $name -}}
{{-     end -}}
{{-   end -}}
{{- /* 勾的跟用途的預設組合不一樣(多勾、少勾都算)就存成自訂。 */ -}}
{{-   if ne $use "custom" -}}
{{-     $preset := get $presets $use -}}
{{-     $same := eq (len $tools) (len $preset) -}}
{{-     range $tools -}}
{{-       if not (has . $preset) }}{{ $same = false }}{{ end -}}
{{-     end -}}
{{-     if not $same }}{{ $use = "custom" }}{{ end -}}
{{-   end -}}
{{- end -}}
{{- /* 憑證與 git 身分:這台已經存過就沿用,沒有才問(chezmoi 官方 setup 指南的寫法,
       https://www.chezmoi.io/user-guide/setup/)。不用 promptStringOnce:`chezmoi init --prompt`
       會讓它重問,而這裡要 --prompt 只重問選單(`tools` 指令靠這個)。
       憑證只問這台用得到的:每一項最後是「勾了其中一個才問」的工具(空的 = 一定問),所以排在選單之後。
       沒勾、也沒存過的不寫進 [data]:之後勾了那個工具,跑 `tools` 或 `chezmoi init` 才問得到
       (寫成空字串就算存過、不會再問了)。用到它的樣板要用 index 取值,或跟著工具被 .chezmoiignore 排除。
       取消勾選不刪存過的值。
       憑證刻意不帶現值當預設 —— 預設值會明文印在提示上;反正已經存過的不會再問。
       之後要改:`chezmoi edit-config` 改 [data] 那一行再 apply。
       每一項是 (key 提示文字 預設值 工具);預設值空字串 = 沒有預設。
       Windows 整段跳過:不部署 .gitconfig、.ssh/config 與用到憑證的設定(見 .chezmoiignore 的 Windows 白名單)。 */ -}}
{{- $answers := dict -}}
{{- $answerKeys := list -}}
{{- if not $windows -}}
{{- range $q := list
      (list "codeServerPassword" "code-server 密碼" "" (list "code-server"))
      (list "codexLbApiKey" "codex-lb API key" "" (list "codex" "opencode"))
      (list "context7ApiKey" "Context7 API key（可留空）" "" (list "agent-config"))
      (list "wakatimeApiKey" "WakaTime API key（可留空）" "" (list "wakatime"))
      (list "gitUserName" "git user.name" "henry" (list))
      (list "gitUserEmail" "git user.email" "" (list)) -}}
{{-   $key := index $q 0 -}}
{{-   $needed := not (index $q 3) -}}
{{-   range index $q 3 }}{{ if has . $tools }}{{ $needed = true }}{{ end }}{{ end -}}
{{-   if hasKey $ $key -}}
{{-     $_ := set $answers $key (index $ $key) -}}
{{-   else if not $needed -}}
{{-     continue -}}
{{-   else if index $q 2 -}}
{{-     $_ := set $answers $key (promptString (index $q 1) (index $q 2)) -}}
{{-   else -}}
{{-     $_ := set $answers $key (promptString (index $q 1)) -}}
{{-   end -}}
{{-   $answerKeys = append $answerKeys $key -}}
{{- end -}}
{{- end -}}
{{- $personal := default dict (index . "aiPersonal") -}}

[data]
{{- range $answerKeys }}
    {{ . }} = {{ get $answers . | quote }}
{{- end }}
{{- if not $windows }}
    machineUse = {{ $use | quote }}
{{- end }}
    tools = {{ $tools | toToml }}
    toolsSchema = 3

    # 個人 Codex 使用的非秘密模型資料。
    [data.aiPersonal]
    codexModel = {{ default "" (index $personal "codexModel") | quote }}
