{{- /* 憑證與 git 身分:這台已經存過就沿用,沒有才問(chezmoi 官方 setup 指南的寫法,
       https://www.chezmoi.io/user-guide/setup/)。不用 promptStringOnce:`chezmoi init --prompt`
       會讓它重問,而這裡要 --prompt 只重問選單(`tools` 指令靠這個)。
       憑證刻意不帶現值當預設 —— 預設值會明文印在提示上;反正已經存過的不會再問。
       之後要改:`chezmoi edit-config` 改 [data] 那一行再 apply。
       每一項是 (key 提示文字 預設值);預設值空字串 = 沒有預設。 */ -}}
{{- $answers := dict -}}
{{- range $q := list
      (list "codeServerPassword" "code-server 密碼" "")
      (list "codexLbApiKey" "codex-lb API key" "")
      (list "context7ApiKey" "Context7 API key（可留空）" "")
      (list "wakatimeApiKey" "WakaTime API key（可留空）" "")
      (list "gitUserName" "git user.name" "henry")
      (list "gitUserEmail" "git user.email" "") -}}
{{-   $key := index $q 0 -}}
{{-   if hasKey $ $key -}}
{{-     $_ := set $answers $key (index $ $key) -}}
{{-   else if index $q 2 -}}
{{-     $_ := set $answers $key (promptString (index $q 1) (index $q 2)) -}}
{{-   else -}}
{{-     $_ := set $answers $key (promptString (index $q 1)) -}}
{{-   end -}}
{{- end -}}
{{- /* 選裝工具:只在 Debian 系 Linux(Ubuntu、WSL、proot Ubuntu)問,第一次預設都不勾,由使用者自己選。
       原生 Termux 不出選單(開發環境放 proot Ubuntu);其他 Linux 也不出,選單裡大半要 apt。
       之後要改:打 `tools`(home/dot_local/bin/executable_tools.tmpl)重出選單,預設帶現在的勾選
       (不在這台選單裡的會被濾掉),勾完直接 apply。新勾的會裝,取消勾選不會解除安裝。
       選項與說明在 .chezmoitemplates/tool-menu。加一個新工具要動三處:
         1. tool-menu 加一行「工具名 說明」。
         2. 走 apt 的放 .chezmoidata/packages.yaml 的 toolPackages;其他的寫一支
            .chezmoiscripts/run_onchange_after_install-<工具>.sh.tmpl,整段包在
            {{ if has "<工具>" .tools }} 裡,已經裝了就跳過
            (用 npm 裝的例外,叫 npm-install-<工具>,見 npm-install-codegraph 開頭)。
         3. 已經 init 過的機器不會自己問,打 `tools` 勾它才會裝。 */ -}}
{{- $tools := list -}}
{{- if includeTemplate "is-debian" . -}}
{{- /* headless Chrome 給 chrome-mcp 在遠端主機自己開 Chrome。WSL 連的是 Windows 的 Chrome,不列;
       Google 只出 amd64 的 .deb,ARM(例如平板上的 proot Ubuntu)也不列。
       playwright-cli 跟著同一個條件:它用的就是這支 Chrome,沒有就報錯、不會自己下載。 */ -}}
{{-   $skip := list -}}
{{-   if or (eq (includeTemplate "is-wsl" .) "true") (ne .chezmoi.arch "amd64") -}}
{{-     $skip = list "headless-chrome" "playwright-cli" -}}
{{-   end -}}
{{- /* 選單上顯示「工具名 + 說明」(工具名補空白對齊),$labels 記工具名 → 選單文字。 */ -}}
{{-   $toolChoices := list -}}
{{-   $labels := dict -}}
{{-   range splitList "\n" (includeTemplate "tool-menu" .) -}}
{{-     $name := index (splitList " " .) 0 -}}
{{-     if and $name (not (has $name $skip)) -}}
{{-       $label := printf "%-16s %s" $name (trimPrefix (printf "%s " $name) .) -}}
{{-       $_ := set $labels $name $label -}}
{{-       $toolChoices = append $toolChoices $label -}}
{{-     end -}}
{{-   end -}}
{{-   $current := list -}}
{{-   if hasKey . "tools" -}}
{{-     $current = .tools -}}
{{-   end -}}
{{- /* 舊的 document-media 已拆成三項,舊機器的勾選照樣帶過去。 */ -}}
{{-   if has "document-media" $current -}}
{{-     $current = concat $current (list "ffmpeg" "mupdf-tools" "pandoc") -}}
{{-   end -}}
{{-   $toolDefaults := list -}}
{{-   range $current -}}
{{-     if and (hasKey $labels .) (not (has (get $labels .) $toolDefaults)) -}}
{{-       $toolDefaults = append $toolDefaults (get $labels .) -}}
{{-     end -}}
{{-   end -}}
{{- /* 選單回傳的是選單文字(已經存過時是存著的工具名),只留第一個空白前的工具名。 */ -}}
{{-   range promptMultichoiceOnce . "tools" "選裝工具（空白鍵勾選，Enter 確定）" $toolChoices $toolDefaults -}}
{{-     $tools = append $tools (index (splitList " " .) 0) -}}
{{-   end -}}
{{- end -}}
{{- $personal := default dict (index . "aiPersonal") -}}

[data]
    codeServerPassword = {{ $answers.codeServerPassword | quote }}
    codexLbApiKey = {{ $answers.codexLbApiKey | quote }}
    context7ApiKey = {{ $answers.context7ApiKey | quote }}
    wakatimeApiKey = {{ $answers.wakatimeApiKey | quote }}
    gitUserName = {{ $answers.gitUserName | quote }}
    gitUserEmail = {{ $answers.gitUserEmail | quote }}
    tools = {{ $tools | toToml }}

    # 個人 Codex 使用的非秘密模型資料。
    [data.aiPersonal]
    codexModel = {{ default "" (index $personal "codexModel") | quote }}
