# ~/.config/git/config —— 走 XDG 這份,不是 ~/.gitconfig。
#
# git 兩份都讀(`git config --list --show-origin` 會同時列出兩個檔),同一個 key
# 以 ~/.gitconfig 為準(後讀的贏)。所以這份只放不涉及身分的共用設定;
# user.name / user.email / core.editor 都在 ~/.gitconfig,那份也由 chezmoi
# 納管(home/dot_gitconfig.tmpl),值走 promptStringOnce,不進這個公開 repo。

# ~/code 底下的 repo 共用一份 git hooks。
#
# 比對的是 **gitdir** 不是工作目錄,所以 herdr 把 worktree 放在 ~/.herdr/ 也算得進來
# —— 那些 worktree 的 gitdir 是 ~/code/<repo>/.git/worktrees/<名字>。
# path 是相對路徑,相對於這個檔案所在的目錄。
[includeIf "gitdir:~/code/"]
	path = config-code
