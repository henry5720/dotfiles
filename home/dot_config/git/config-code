# 只對 ~/code 底下的 repo 生效,由 config 的 includeIf 帶進來。

# 共用 hooks 目錄。目前兩支,都是 codegraph 索引:post-checkout 讓新開的 worktree
# 自動帶上索引,post-merge 在 git pull / merge 之後把索引補上。
#
# 改 hooksPath 會讓 repo 自己的 .git/hooks/ 整個失效。設定當時清過一遍:
# ~/code 的 12 個 repo 加 8 個子 repo,.git/hooks/ 全部只有 .sample,沒有真 hook,
# 所以沒有東西被踩掉。
#
# ⚠️ repo 在自己的 local config 設了 core.hooksPath 的話(husky 就是這樣做),
# **local 贏 global**,這份完全不生效,而且是靜默的。檢查方式:
#   git config --get core.hooksPath      # 有輸出 = 被搶走了
# 那種 repo 要在它自己的 hook 目錄放一支轉接,見 docs/ai-agent-setup.md。
[core]
	hooksPath = ~/.config/git/hooks
