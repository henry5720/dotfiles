#!/bin/sh
# `git pull` / `git merge` 之後把 codegraph 索引補上。
#
# 為什麼需要這支 —— 索引的自動更新是綁在 MCP server 上的(見
# docs/codegraph.md〈索引什麼時候會跟上你的改動〉):你在某個 repo 開 agent,
# server 起來、watcher 跟著跑,你改的檔才會即時進索引。
#
# 但有些 repo 你不會在裡面開 agent —— 你是從別的 repo 用 `-p <那個路徑>` 查過去的。
# 那種 repo 沒有 server,`git pull` 拉進來的改動就永遠不會進索引,
# 而查詢不會告訴你索引是舊的。
#
# 成本很低:sync 比對的是檔案內容雜湊不是 mtime,內容沒變就不重解析 ——
# 實測 touch 1000 個檔只要 0.77 秒。
#
# 全部用 if 包、最後明確 exit 0:husky 的 shim 用 `sh -e` 執行這支,
# `[ 條件 ] && ...` 的收尾在條件不成立時會讓整支以 1 結束。

top=$(git rev-parse --show-toplevel 2>/dev/null) || top=''

if [ -n "$top" ] && [ -d "$top/.codegraph" ] && command -v codegraph >/dev/null 2>&1; then
	codegraph sync -q "$top" || true
fi

exit 0
