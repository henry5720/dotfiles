#!{{ lookPath "sh" }}
# skillshare 的全域設定。skills 與 MCP 的內容在 agent-config repo,這份只告訴 skillshare 去哪找、寫到哪。
# config.yaml 不進 agent-config(root 模式會自動 ignore 它),所以由 chezmoi 放;
# 沒勾 agent-config 的機器不放(.chezmoiignore)。
#
# 用 modify_ 而不是 create_:skillshare init 與 extras 指令會改寫這個檔(加 schema 註解、重排 key),
# 所以只釘 targets 與 extras 兩段(內容在 .chezmoitemplates/skillshare-pinned,照勾的 client 產生),
# 其餘照 skillshare 寫的留著;新機器(檔案不存在)才從整份基底開始。
# 兩段每次 apply 都整段換掉:手動 `skillshare target add` 加的 target 會被蓋掉,真相只在 repo。
# extras 是給模型讀的指令檔(Instructions):內容在 agent-config 的 instructions/,
# 由 skillshare 連到各 client 讀的位置(決策見 docs/adr/0003-*.md)。
# 兩段變了,run_onchange_after_sync-skillshare 會在 apply 後跑 skillshare sync --all。
# 取消勾選 client 時,已經同步出去的 skill 與連結留著(跟「取消勾選不會解除安裝」一致)。
#
# sources 不列 agents:不寫 skillshare 也預設看 ~/.config/skillshare/agents(agent-config 的 agents/),
# 目錄不存在時 sync 只印「No agents folder」。

set -eu

pinned=$(cat <<'EOF'
{{ includeTemplate "skillshare-pinned" . }}
EOF
)

# 1. 吃現有內容;檔案不存在時(新機器)stdin 是空的,從 init 前的基底開始。
#    要先放好再 init,init 才會直接從 remote 拉下來(流程見 run_onchange_after_install-agent-config.sh.tmpl)。
existing=$(cat)
if [ -z "$existing" ]; then
  existing=$(cat <<'EOF'
git_root: root
preserve_tilde_on_save: true
sources:
  skills: ~/.config/skillshare/skills
  mcp: ~/.config/skillshare/mcp.yaml
EOF
)
fi

# 2. 現有的 targets、extras 段(到下一個頂層 key 為止)原地換成釘的那份,沒有就接在最後;
#    釘的那份沒有這段(例如沒勾任何 agent 時的 extras)就整段拿掉。
#    段落之間的空行先暫存,遇到下一個 key 才印;整段拿掉時沿用它前面的空行,不會多出兩行空白。
printf '%s\n' "$existing" | PINNED="$pinned" awk '
  BEGIN {
    owned["targets"] = owned["extras"] = 1
    n = split(ENVIRON["PINNED"], lines, "\n")
    for (i = 1; i <= n; i++) {
      if (lines[i] ~ /^[^ \t#-]/) { key = lines[i]; sub(/:.*/, "", key); order[++k] = key }
      if (lines[i] != "") body[key] = body[key] lines[i] "\n"
    }
  }
  /^[[:space:]]*$/ { blank = blank $0 "\n"; next }
  /^[^ \t#-]/ {
    if (dropped) { blank = kept; dropped = 0 }
    skip = 0
    key = $0; sub(/:.*/, "", key)
    if (key in owned) {
      skip = 1; done[key] = 1
      if (key in body) { printf "%s%s", blank, body[key] } else { dropped = 1; kept = blank }
      blank = ""; next
    }
    printf "%s", blank; blank = ""; print; next
  }
  skip { blank = ""; next }
  { printf "%s", blank; blank = ""; print }
  END {
    if (!dropped) printf "%s", blank
    for (i = 1; i <= k; i++) if (!(order[i] in done)) { print ""; printf "%s", body[order[i]] }
  }
'
