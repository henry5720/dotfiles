#!{{ lookPath "sh" }}
# skillshare 的全域設定。skills 與 MCP 的內容在 agent-config repo,這份只告訴 skillshare 去哪找、寫到哪。
# config.yaml 不進 agent-config(root 模式會自動 ignore 它),所以由 chezmoi 放。
#
# 用 modify_ 而不是 create_:skillshare init 與 extras 指令會改寫這個檔(加 schema 註解、重排 key),
# 所以只釘 extras 段與 Claude target 的 agents 路徑,其餘照 skillshare 寫的留著;
# 新機器(檔案不存在)才從整份基底開始。
# extras 是給模型讀的指令檔(Instructions):內容在 agent-config 的 instructions/,
# 由 skillshare 連到各 client 讀的位置(決策見 docs/adr/0003-*.md)。
# 改了 extras 段,run_onchange_after_sync-skillshare-extras 會在 apply 後跑 skillshare sync extras。
#
# extras 的欄位順序照 skillshare 存檔的樣子(name、source、file、targets),段內也不放註解(它存檔會拿掉),
# 它改寫後再 apply 才不會出現只有排版不同的 diff。
# agents-md 是一份 AGENTS.md 給四個 client,Claude 讀的檔名是 CLAUDE.md;
# agent-commit、opencode-commit 的目標路徑要對上 AGENTS.md 與 opencode.json 引用的位置。
# sources 不列 agents:不寫 skillshare 也預設看 ~/.config/skillshare/agents(agent-config 的 agents/),
# 目錄不存在時 sync 只印「No agents folder」。agents 路徑只給 Claude:Codex 的 subagent 是 TOML,
# native agents target 不能轉檔,要用時得走 extras 的 codex-agents extension。
# agents 放在 claude 的 skills 後面,跟 skillshare 存檔的順序一樣。

set -eu

extras=$(cat <<'EOF'
extras:
  - name: agents-md
    source: ~/.config/skillshare/instructions/agents-md
    file: AGENTS.md
    targets:
      - path: ~/.claude
        as: CLAUDE.md
      - path: ~/.codex
      - path: ~/.config/opencode
      - path: ~/.config/opencode/routes/personal
  - name: agent-commit
    source: ~/.config/skillshare/instructions/agent-commit
    file: instructions.md
    targets:
      - path: ~/.config/agent-commit
  - name: opencode-commit
    source: ~/.config/skillshare/instructions/opencode-commit
    file: commit-instructions.md
    targets:
      - path: ~/.config/opencode
EOF
)

# 1. 吃現有內容;檔案不存在時(新機器)stdin 是空的,從 init 前的基底開始。
#    要先放好再 init,init 才會直接從 remote 拉下來(流程見 run_onchange_after_install-agent-config.sh.tmpl)。
existing=$(cat)
if [ -z "$existing" ]; then
  existing=$(cat <<'EOF'
git_root: root
preserve_tilde_on_save: true
sources:
  skills: ~/.config/skillshare/skills
  mcp: ~/.config/skillshare/mcp.yaml
targets:
  claude:
    skills:
      path: ~/.claude/skills
  codex:
    skills:
      path: ~/.agents/skills
EOF
)
fi

# 2. 已有 extras 段就原地換掉(到下一個頂層 key 為止),沒有就接在最後;
#    targets 底下 claude 的 agents 子段先拿掉,在 claude 段結尾補上釘的那份。
#    段落之間的空行先暫存,段落結束時才印,留給下一個 key。
printf '%s\n' "$existing" | awk -v extras="$extras" '
  function end_claude() { if (claude) { print "    agents:"; print "      path: ~/.claude/agents"; claude = 0 } }
  /^[[:space:]]*$/ { if (claude || skip) { blank = blank $0 "\n"; next } print; next }
  /^[^ \t-]/ {
    end_claude(); skip = 0; printf "%s", blank; blank = ""
    if (/^extras:/) { print extras; skip = 1; done = 1; next }
    top = $0; print; next
  }
  skip { blank = ""; next }
  top == "targets:" && /^  [^ ]/ {
    end_claude(); printf "%s", blank; blank = ""
    if ($0 == "  claude:") { claude = 1; sub_agents = 0 }
    print; next
  }
  claude && /^    [^ ]/ { sub_agents = ($0 == "    agents:") }
  claude && sub_agents { blank = ""; next }
  { printf "%s", blank; blank = ""; print }
  END { end_claude(); if (!done) { print ""; print extras } }
'
