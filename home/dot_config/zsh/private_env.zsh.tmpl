{{- /* 兩個 key 都留空時整份渲染成空的，chezmoi 就不部署這個檔。
       沒勾 agent-config 的機器 config 裡沒有這些 key（見 .chezmoi.toml.tmpl），用 index 取才不會報錯。 */ -}}
{{- $context7 := index . "context7ApiKey" -}}
{{- $graphify := index . "graphifyApiKey" -}}
{{- if or $context7 $graphify -}}
# 由 chezmoi 從 ~/.config/chezmoi/chezmoi.toml 渲染（權限 600），值不進 repo。
# skillshare 寫進各 client 的 MCP 設定只留 fromEnv／bearerToken 參照，值從這裡來。
{{ with $context7 }}export CONTEXT7_API_KEY={{ . | squote }}
{{ end -}}
{{ with $graphify }}export GRAPHIFY_API_KEY={{ . | squote }}
{{ end -}}
{{ end -}}
