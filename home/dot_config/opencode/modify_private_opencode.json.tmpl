{{- /* ~/.config/opencode/opencode.json 兩方共用:provider、agent、plugin 這些由這個 repo 管,
       `mcp` 由 skillshare 管(清單在 agent-config 的 mcp.yaml,`skillshare sync mcp -g` 寫進來)。
       整份部署的話每次 apply 都會把 skillshare 寫的 MCP 蓋掉,所以用 modify_:
       整個照 repo 的版本(.chezmoitemplates/opencode-json)輸出,只有 `mcp` 換回現有檔案裡的那一段。

       渲染成 modify-template(chezmoi 拿現有檔案當 .chezmoi.stdin 再跑一次),所有平台同一份
       (#318 先用在 Windows,#204 起 Linux、macOS、Termux 也用,不再靠 sh + jq)。輸出經 toPrettyJson,key 照字母排。
       repo 的版本先在這一輪渲染好,用 JSON 字串字面值放進下一輪(JSON 的跳脫是 Go 字串字面值的子集)。 */ -}}
{{ "{{-" }} /* chezmoi:modify-template */ {{ "-}}" }}
{{ "{{-" }} $repo := fromJson {{ includeTemplate "opencode-json" . | toJson }} {{ "-}}" }}
{{ "{{-" }} $mcp := dict {{ "-}}" }}
{{ "{{-" }} if trim .chezmoi.stdin {{ "}}{{" }} $mcp = get (fromJson .chezmoi.stdin) "mcp" | default dict {{ "}}{{" }} end {{ "-}}" }}
{{ "{{" }} set $repo "mcp" $mcp | toPrettyJson "  " {{ "}}" }}
{{- /* 上一行的換行不輸出:toPrettyJson 自己以換行結尾 */ -}}
