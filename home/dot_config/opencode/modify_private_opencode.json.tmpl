#!{{ lookPath "sh" }}
# shebang 用 lookPath:Termux 沒有 /bin/sh,而 chezmoi 是 Go、繞過 termux-exec,寫死 /bin/sh 會 fork/exec 失敗。
# ~/.config/opencode/opencode.json 兩方共用:provider、agent、plugin 這些由這個 repo 管,
# `mcp` 由 skillshare 管(清單在 agent-config 的 mcp.yaml,`skillshare sync mcp -g` 寫進來)。
# 整份部署的話每次 apply 都會把 skillshare 寫的 MCP 蓋掉,所以用 modify_:
# 下面這份整個照 repo 的版本輸出,只有 `mcp` 換回現有檔案裡的那一段。
{{- $company := include (joinPath .chezmoi.sourceDir "dot_config/opencode/oh-my-opencode-slim.json") | fromJson -}}
{{- $active := index (index $company "presets") (index $company "preset") -}}
{{- $main := index (index $active "orchestrator") "model" -}}
{{- $small := index (index $active "explorer") "model" -}}
set -eu

# 1. 吃現有內容;檔案不存在時(新機器)stdin 是空的,墊一個空物件給 jq。
existing=$(cat)
[ -n "$existing" ] || existing='{}'

# 2. repo 的版本。"mcp": {} 只是佔位,讓 key 留在原本的位置。
printf '%s' "$existing" | jq --argjson repo "$(cat <<'JSON'
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [{{ printf "%s/.config/opencode/commit-instructions.md" .chezmoi.homeDir | toJson }}],
  "model": {{ $main | toJson }},
  "small_model": {{ $small | toJson }},
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/code/**": "allow",
      "/tmp/**": "allow",
      "~/.local/share/chezmoi/**": "allow"
    }
  },
  "provider": {
    "codex-lb-gcp": {
      "npm": "@ai-sdk/openai",
      "name": "TeamSync",
      "options": {
        "baseURL": "https://codex.teamsync.com.tw/backend-api/codex",
        "apiKey": "{{ .codexLbApiKey }}"
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        }
      }
    }
  },
  "mcp": {},
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "plugin": [
    "opencode-wakatime",
    "oh-my-opencode-slim"
  ]
}
JSON
)" '$repo + {mcp: (.mcp // {})}'
