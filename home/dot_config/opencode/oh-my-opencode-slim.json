{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@3.0.7/oh-my-opencode-slim.schema.json",
  "preset": "teamsync",
  "autoUpdate": false,
  "presets": {
    "teamsync": {
      "orchestrator": {
        "model": "codex-lb-gcp/gpt-6.1-sol",
        "variant": "medium"
      },
      "oracle": {
        "model": "codex-lb-gcp/gpt-6.1-sol",
        "variant": "high",
        "skills": [
          "simplify"
        ]
      },
      "council": {
        "model": "codex-lb-gcp/gpt-6.1-sol",
        "variant": "high"
      },
      "explorer": {
        "model": "codex-lb-gcp/gpt-6-luna",
        "variant": "low"
      },
      "designer": {
        "model": "codex-lb-gcp/gpt-6-luna",
        "variant": "medium"
      },
      "fixer": {
        "model": "codex-lb-gcp/gpt-6.1-sol",
        "variant": "low"
      }
    }
  },
  "council": {
    "default_preset": "teamsync",
    "presets": {
      "teamsync": {
        "terra": {
          "model": "codex-lb-gcp/gpt-6-astra",
          "variant": "high"
        },
        "sol": {
          "model": "codex-lb-gcp/gpt-6.1-sol",
          "variant": "high"
        },
        "luna": {
          "model": "codex-lb-gcp/gpt-6-luna",
          "variant": "high"
        }
      }
    }
  },
  "acpAgents": {
    "claude-code": {
      "command": "npx",
      "args": [
        "-y",
        "@agentclientprotocol/claude-agent-acp"
      ],
      "description": "Claude Code specialist；由 OMO 依任務自行決定是否委派。",
      "wrapperModel": "codex-lb-gcp/gpt-6-luna",
      "permissionMode": "ask",
      "timeoutMs": 0
    }
  }
}
