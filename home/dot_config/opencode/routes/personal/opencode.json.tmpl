{{- $company := include (joinPath .chezmoi.sourceDir "dot_config/opencode/oh-my-opencode-slim.json") | fromJson -}}
{{- $agents := index (index $company "presets") (index $company "preset") -}}
{{- $main := regexReplaceAll "^[^/]+/" (index (index $agents "orchestrator") "model") "" -}}
{{- $small := regexReplaceAll "^[^/]+/" (index (index $agents "explorer") "model") "" -}}
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [{{ printf "%s/.config/opencode/commit-instructions.md" .chezmoi.homeDir | toJson }}],
  "permission": {
    "skill": {
      "company-imagegen-fallback": "deny"
    }
  },
  "enabled_providers": ["openai"],
  "model": {{ printf "openai/%s" $main | quote }},
  "small_model": {{ printf "openai/%s" $small | quote }}
}
