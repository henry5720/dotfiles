{{- $company := include (joinPath .chezmoi.sourceDir "dot_config/opencode/oh-my-opencode-slim.json") | fromJson -}}
{{- $agents := deepCopy (index (index $company "presets") (index $company "preset")) -}}
{{- range $name, $agent := $agents -}}
{{- $_ := set $agent "model" (regexReplaceAll "^[^/]+/" (index $agent "model") "openai/") -}}
{{- end -}}
{{- $councilName := index (index $company "council") "default_preset" -}}
{{- $council := deepCopy (index (index (index $company "council") "presets") $councilName) -}}
{{- range $name, $agent := $council -}}
{{- $_ := set $agent "model" (regexReplaceAll "^[^/]+/" (index $agent "model") "openai/") -}}
{{- end -}}
{{- $route := dict "$schema" (index $company "$schema") "preset" "personal" "presets" (dict "personal" $agents) "council" (dict "default_preset" "personal" "presets" (dict "personal" $council)) "disabled_tools" (list "acp_run") "fallback" (dict "enabled" false) "autoUpdate" (index $company "autoUpdate") -}}
{{ toPrettyJson $route }}
