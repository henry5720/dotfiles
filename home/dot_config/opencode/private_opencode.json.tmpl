{
  "$schema": "https://opencode.ai/config.json",
  "model": "codex-lb-gcp/gpt-6-astra",
  "small_model": "codex-lb-gcp/gpt-5.6-luna",
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/code/**": "allow",
      "/tmp/**": "allow",
      "~/.local/share/chezmoi/**": "allow"
    }
  },
  "provider": {
    "codex-lb-gcp": {
      "npm": "@ai-sdk/openai",
      "name": "TeamSync",
      "options": {
        "baseURL": "https://codex.teamsync.com.tw/backend-api/codex",
        "apiKey": "{{ .codexLbApiKey }}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "codegraph": {
      "enabled": true,
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ]
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "plugin": [
    "opencode-wakatime",
    "oh-my-opencode-slim"
  ]
}
