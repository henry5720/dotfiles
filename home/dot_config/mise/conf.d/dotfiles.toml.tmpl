{{- /* 有工具要交給 mise 的 Linux 與 Windows 主機(一定有 zoxide)才有這個檔(.chezmoitemplates/mise-tools);其他機器 .chezmoiignore 整個 ~/.config/mise 不管。
       清單是空的(什麼都不用 mise 裝)就渲染成空的,chezmoi 不建這個檔。 */ -}}
{{- $list := includeTemplate "mise-tools" . -}}
{{- if $list -}}
# chezmoi 照選裝工具的勾選產生(home/dot_config/mise/conf.d/dotfiles.toml.tmpl),別直接改,下次 apply 會蓋掉。
# 自己要加的工具用 `mise use -g <工具>`,寫在 ~/.config/mise/config.toml,不會跟這份打架。
# 怎麼挑的見 home/.chezmoidata/packages.yaml 的 miseTools;run_onchange_after_install-mise 在這份變了之後跑 mise install。
[tools]
{{- $list }}
{{ end -}}
