# 外部 repo:chezmoi apply 時下載,不收進這個 repo。
# git-repo 類型要外部 git,由 run_onchange_before_install-packages 先裝好。
#
# git-repo 的目錄已經存在就不會重新 clone,所以舊機器用 install-base.sh clone 的那份
# 會直接被接手。沒設 refreshPeriod:平常 apply 不連網更新,要更新就 `chezmoi apply -R`。

# ===============================================================
# 1. zsh 主題與插件(home/dot_zshrc 從這些路徑 source)
# ===============================================================
[".config/zsh/powerlevel10k"]
    type = "git-repo"
    url = "https://github.com/romkatv/powerlevel10k.git"
    clone.args = ["--depth", "1"]
    pull.args = ["--ff-only"]

[".config/zsh/zsh-autosuggestions"]
    type = "git-repo"
    url = "https://github.com/zsh-users/zsh-autosuggestions.git"
    clone.args = ["--depth", "1"]
    pull.args = ["--ff-only"]

[".config/zsh/zsh-syntax-highlighting"]
    type = "git-repo"
    url = "https://github.com/zsh-users/zsh-syntax-highlighting.git"
    clone.args = ["--depth", "1"]
    pull.args = ["--ff-only"]

# ===============================================================
# 2. Termux 終端機字型(只有 android)
# ===============================================================
{{- if eq .chezmoi.os "android" }}
# 原生 Termux app 的終端機字型:Hack Nerd Font Regular(p10k 是 nerdfont-v3,任何 Nerd Font v3 都相容)。
# v3.5.1 的 repo 沒有單一 ttf,從 release asset 的壓縮檔取一個檔案。
# URL 釘 release tag,不設 refreshPeriod;要換字型或版本就改 url／path,
# 同時改 run_onchange_after_termux-reload-settings.sh.tmpl 註解裡的 URL,讓它重跑 reload。
# 不裝 Termux:Styling(它換字型會覆蓋這個檔),colors.properties 也不收,用 Termux 預設配色。
[".termux/font.ttf"]
type = "archive-file"
url  = "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/Hack.tar.xz"
path = "HackNerdFont-Regular.ttf"
{{- end }}
