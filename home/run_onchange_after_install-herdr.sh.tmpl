{{- if has "herdr" (index . "tools") -}}
#!{{ lookPath "sh" }}
# 選裝工具 herdr(選單見 .chezmoi.toml.tmpl)。沒勾就渲染成空的,chezmoi 不跑。
# 官方 installer 裝到 ~/.local/bin;之後用 herdr update 更新。
set -eu

if command -v herdr >/dev/null 2>&1; then
  echo "herdr 已安裝,跳過"
  exit 0
fi
curl -fsSL https://herdr.dev/install.sh | sh
{{ end -}}
