#!{{ lookPath "sh" }}
# 在 ~/.bashrc 最後加兩段,各有各的部署條件(.chezmoiignore 在兩個都不成立時才不部署這個檔):
# - starship 提示列:勾了選裝工具 starship。zsh 那邊寫在 home/dot_zshrc,兩邊共用 ~/.config/starship.toml。
# - 互動式 bash 切到 zsh:apt 用不了的 Linux(沒有 root,或非 Debian 系)、勾了 zsh(.chezmoitemplates/bash-to-zsh)。
#   不用 chsh,改成互動式 bash 一啟動就 exec zsh。非互動的 bash(bash -c、scp、ssh 帶指令)留在 bash。
#   zsh 優先用 zsh-bin 裝的 ~/.local/bin/zsh(run_onchange_before_install-home-jq-zsh),
#   這時 PATH 不一定有 ~/.local/bin;沒有就找 PATH 上的(例如管理員裝的)。都沒有就留在 bash。
#
# modify_:現有的 ~/.bashrc 從 stdin 進來,輸出成新內容。兩段都先從原處拿掉、再依序接在最後,
# 所以重跑內容不變。條件成立的印這次的內容;不成立的把原本那段原樣搬回來(沒有就不印),
# 跟「取消勾選不會解除安裝」一致;要拿掉就刪掉標記之間的那段(並取消勾選,不然下次 apply 又會加回來)。
# 切 zsh 那段一律排最後:exec 之後的內容不會執行。
{{- $starship := has "starship" (index . "tools") }}
{{- $bashToZsh := includeTemplate "bash-to-zsh" . }}
set -eu
starship_begin='# >>> dotfiles:starship 提示列 >>>'
starship_end='# <<< dotfiles:starship 提示列 <<<'
zsh_begin='# >>> dotfiles:互動式 bash 切到 zsh >>>'
zsh_end='# <<< dotfiles:互動式 bash 切到 zsh <<<'
in=$(mktemp)
trap 'rm -f "$in"' EXIT
cat > "$in"

# 1. 原本的內容,兩段都拿掉
awk -v b1="$starship_begin" -v e1="$starship_end" -v b2="$zsh_begin" -v e2="$zsh_end" '
  $0 == b1 || $0 == b2 {skip = 1}
  !skip {print}
  skip && ($0 == e1 || $0 == e2) {skip = 0}
' "$in"

# 原本那段(含標記)原樣印出;沒有就不印
old_block() {
  awk -v b="$1" -v e="$2" '$0 == b {on = 1} on {print} on && $0 == e {on = 0}' "$in"
}

# 2. starship:~/.local/bin 那支優先(Linux 由 install-cli-tools 裝在那裡,這時 PATH 不一定有它),
#    沒有就找 PATH 上的(Termux 的 pkg、macOS 的 brew)。都沒有就用 bash 預設的提示列。
{{- if $starship }}
cat <<'BASHRC'
# >>> dotfiles:starship 提示列 >>>
case $- in
  *i*)
    for s in "$HOME/.local/bin/starship" "$(command -v starship 2>/dev/null)"; do
      if [ -n "$s" ] && [ -x "$s" ]; then eval "$("$s" init bash)"; break; fi
    done
    unset s
    ;;
esac
# <<< dotfiles:starship 提示列 <<<
BASHRC
{{- else }}
old_block "$starship_begin" "$starship_end"
{{- end }}

# 3. 切到 zsh
{{- if $bashToZsh }}
cat <<'BASHRC'
# >>> dotfiles:互動式 bash 切到 zsh >>>
if [ -z "${ZSH_VERSION:-}" ]; then
  case $- in
    *i*)
      for z in "$HOME/.local/bin/zsh" "$(command -v zsh 2>/dev/null)"; do
        if [ -n "$z" ] && [ -x "$z" ]; then export SHELL="$z"; exec "$z" -l; fi
      done
      unset z
      ;;
  esac
fi
# <<< dotfiles:互動式 bash 切到 zsh <<<
BASHRC
{{- else }}
old_block "$zsh_begin" "$zsh_end"
{{- end }}
